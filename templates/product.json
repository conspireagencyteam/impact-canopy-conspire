e selected_product -%}\n  {%- for option in product.options_with_values -%}{{ option.name }}: {{ option.selected_value }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}\n{%- endcapture -%}\n<input type=\"hidden\" name=\"handle\" value=\"{{ product.handle }}\">\n<input type=\"hidden\" name=\"variant\" value=\"{{- selected_product -}}\">\n<!--  ----------------------------------------------------------------------  -->\n<!--  NOTE: These fields are optional debugging elements. Please uncomment    -->\n<!--  these lines if you wish to test in debug mode.                          -->\n<!--  <input type=\"hidden\" name=\"debug\" value=1>                              -->\n<!--  <input type=\"hidden\" name=\"debugEmail\" value=\"marketing@impactcanopy.com\">       -->\n<!--  ----------------------------------------------------------------------  -->\n<!-- Form Fields -->\n<label for=\"selectyourrep\">Have you worked with us before? Select Your Sales Rep</label><select  id=\"Web_Form_Rep__c\" name=\"Web_Form_Rep__c\" title=\"Select Your Sales Rep\"><option value=\"\">--New Customer--</option><option value=\"Anne Bohl\">Anne Bohl</option>\n<option value=\"Aaron Harvey\">Aaron Harvey</option>\n<option value=\"Patrick Wheelan\">Patrick Wheelan (Food Service)</option>\n<option value=\"Don Puerling\">Don Puerling (Baseball/Softball)</option>\n<option value=\"Joe Delucia\">Joe Delucia (Field Sports)</option>\n<option value=\"Justin Petty\">Justin Petty (Motorsports)</option>\n<option value=\"Keith Townson\">Keith Townson (Soccer)</option>\n<option value=\"Luis Curiel\">Luis Curiel (Soccer)</option>\n<option value=\"Michelle Goerss\">Michelle Goerss</option>\n<option value=\"Mike Ohirko\">Mike Ohirko</option>\n<option value=\"Nancy Van Echten\">Nancy Van Echten</option>\n<option value=\"Rachel Hart\">Rachel Hart</option>\n<option value=\"Mike Smith\">Mike Smith (Motorsports-Karting)</option>\n</select><br>\n\n<label for=\"first_name\">First Name</label><input  id=\"first_name\" maxlength=\"40\" name=\"first_name\" size=\"20\" type=\"text\" /><br>\n<label for=\"last_name\">Last Name</label><input  id=\"last_name\" maxlength=\"80\" name=\"last_name\" size=\"20\" type=\"text\" /><br>\n<label for=\"email\">Email</label><input  id=\"email\" maxlength=\"80\" name=\"email\" size=\"20\" type=\"text\" required /><br>\n<label for=\"phone\">Phone</label><input  id=\"phone\" maxlength=\"40\" name=\"phone\" size=\"20\" type=\"text\" /><br>\n<label for=\"zip\">Postal Code*</label><input  id=\"Zip_Postal_Code__c\" maxlength=\"10\" name=\"Zip_Postal_Code__c\" size=\"20\" type=\"text\" /><br>\n<label for=\"quantity\">Quantity</label><input  id=\"00NRp0000000S17\" name=\"00NRp0000000S17\" size=\"20\" type=\"text\" /><br>\n<label for=\"company\">Company</label><input  id=\"company\" maxlength=\"40\" name=\"company\" size=\"20\" type=\"text\" /><br>\n<label for=\"business\">Business Type</label><input  id=\"00N4U000008Fzqc\" name=\"00N4U000008Fzqc\" size=\"12\" type=\"text\" ></input ><br>\n\n<!--RECAPTCHA CODE 2 of 2)-->\n<script>\n  function onSubmit(token) {\n    document.getElementById(\"myWebToLeadForm\").submit();\n  }\n</script>\n<input type=hidden name='captcha_settings' value='{\"keyname\":\"RecaptchaBadgev2\",\"fallback\":\"true\",\"orgId\":\"00DU0000000YU2Y\",\"ts\":\"\"}'>\n  <div class=\"g-recaptcha\"\n       data-sitekey=\"6LdaMQQrAAAAACBI8mdCNlC2szstRqJxUb8xyKLK\"\n       data-callback=\"onCaptchaSuccess\"\n       data-expired-callback=\"onCaptchaExpired\">\n  </div>\n<!-- Visible Error Message -->\n  <p id=\"captchaError\" style=\"color: red; display: none;\">Please confirm you're not a robot before submitting.</p>\n<!-- Submit Button (starts disabled) -->\n  <input type=\"submit\" id=\"submitBtn\" name=\"submit\" value=\"Get A Quote\" disabled>\n<!-- End Recaptcha Code -->\n</form>\n<!-- JavaScript to Control reCAPTCHA Behavior -->\n<script>\n  function onCaptchaSuccess() {\n    document.getElementById(\"submitBtn\").disabled = false;\