    "custom_liquid_xtX4ri": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<script>\n      document.addEventListener('DOMContentLoaded', function () {\n        const formContainers = document.querySelectorAll('.custom-sale-group-form-modified');\n          formContainers.forEach(function (formContainer) {\n            const saleTitle = formContainer.querySelector('.sale-title');\n            const selectlabel = formContainer.querySelector('label[for=\"selectyourrep\"]');     \n            const select = formContainer.querySelector('select[title=\"Select Your Sales Rep\"]');\n\n            if (!select) return;\n\n            const hiddenInput = document.createElement('input');\n            hiddenInput.type = 'hidden';\n            hiddenInput.id = select.id;\n            hiddenInput.name = select.name;\n            hiddenInput.value = saleTitle.textContent.trim();\n\n            select.parentNode.insertBefore(hiddenInput, select);\n            select.remove();\n            if (selectlabel) selectlabel.remove();\n          });\n      });\n    </script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0,
        "use_mobile_padding": false,
        "padding-block-start-mobile": 0,
        "padding-block-end-mobile": 0,
        "padding-inline-start-mobile": 0,
        "padding-inline-end-mobile": 0
      }
    }
