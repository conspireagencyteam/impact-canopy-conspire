<div class="block-visibility block-visibility--{{ block.settings.display }}">
{% liquid
  assign block_settings = block.settings
  assign label = label
  assign value = value
  assign bar_color = block_settings.bar_color
  assign bar_bg_color = block_settings.bar_bg_color
  assign type_preset = block_settings.type_preset

  capture label_classes
    echo 'progress-bar__label'
    if type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    elsif type_preset != 'rte'
      echo ' font-' | append: type_preset
    endif
  endcapture
%}

<div
  class="progress-bar progress-bar--{{ block.id }} spacing-style"
  style="
    --progress-bar-fill: {{ value }}%;
    --progress-bar-color: {{ bar_color }};
    --progress-bar-bg: {{ bar_bg_color }};
    {% render 'spacing-style', settings: block_settings %}
  "
  {{ block.shopify_attributes }}
>
  {% if label != blank %}
    <span
      class="{{ label_classes }}"
      style="{% render 'typography-style', settings: block_settings %}"
    >{{ label }}</span>
  {% endif %}
  <div class="progress-bar__track">
    <div class="progress-bar__fill"></div>
  </div>
</div>

{% stylesheet %}
  .progress-bar {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  .progress-bar__label.font-h1 { font-family: var(--font-h1--family); font-size: var(--font-h1--size); font-weight: var(--font-h1--weight); line-height: var(--font-h1--line-height); }
  .progress-bar__label.font-h2 { font-family: var(--font-h2--family); font-size: var(--font-h2--size); font-weight: var(--font-h2--weight); line-height: var(--font-h2--line-height); }
  .progress-bar__label.font-h3 { font-family: var(--font-h3--family); font-size: var(--font-h3--size); font-weight: var(--font-h3--weight); line-height: var(--font-h3--line-height); }
  .progress-bar__label.font-h4 { font-family: var(--font-h4--family); font-size: var(--font-h4--size); font-weight: var(--font-h4--weight); line-height: var(--font-h4--line-height); }
  .progress-bar__label.font-h5 { font-family: var(--font-h5--family); font-size: var(--font-h5--size); font-weight: var(--font-h5--weight); line-height: var(--font-h5--line-height); }
  .progress-bar__label.font-h6 { font-family: var(--font-h6--family); font-size: var(--font-h6--size); font-weight: var(--font-h6--weight); line-height: var(--font-h6--line-height); }
  .progress-bar__label.font-paragraph { font-family: var(--font-paragraph--family); font-size: var(--font-paragraph--size); font-weight: var(--font-paragraph--weight); line-height: var(--font-paragraph--line-height); }

  /* Custom typography styles for progress bar labels */
  .progress-bar__label.custom-typography {
    font-family: var(--font-family);
    font-weight: var(--font-weight);
    text-transform: var(--text-transform);
    text-wrap: var(--text-wrap);
    line-height: var(--line-height);
    letter-spacing: var(--letter-spacing);
  }

  .progress-bar__label.custom-font-size {
    font-size: var(--font-size);
  }

  .progress-bar__label.custom-color {
    color: var(--color);
  }

  .progress-bar__track {
    width: 100%;
    height: 16px;
    background: var(--progress-bar-bg, #e0e0e0);
    border: 1px solid #ccc;
    border-radius: 100px;
    overflow: hidden;
  }

  .progress-bar__fill {
    height: 100%;
    width: var(--progress-bar-fill, 0%);
    background: var(--progress-bar-color, #f47920);
    border-radius: 0;
    transition: width 0.3s ease;
  }
{% endstylesheet %}
</div>

