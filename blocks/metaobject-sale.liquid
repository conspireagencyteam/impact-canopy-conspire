<div class="block-visibility block-visibility--{{ block.settings.display }}">
{%- liquid
  if block.settings.representative != blank
    assign metaobject_list = block.settings.representative.speciality

  elsif item != blank
    assign metaobject_list = item
  else
    assign metaobject_list = metaobject.speciality
  endif
-%}
{% stylesheet %}
  .metaobject-pdp {
    width: 100%;
  }

  .metaobject-pdp__items {
    display: flex;
    gap: var(--gap, 6px);
    flex-wrap: wrap;
  }

  /* Mobile: Always single column */
  @media screen and (max-width: 749px) {
    .metaobject-pdp__items {
      display: flex;
    }
  }
{% endstylesheet %}

{%- if metaobject_list.value != blank -%}
  <div
    class="metaobject-pdp spacing-style border-style{% if block.settings.inherit_color_scheme == false %} color-{{ block.settings.color_scheme }}{% endif %}"
    style="
      --gap: {{ block.settings.gap }}px;
      {% render 'spacing-style', settings: block.settings %}
      {% render 'border-override', settings: block.settings %}
    "
    {{ block.shopify_attributes }}
  >
    {% content_for 'block',type: 'text', id: "static_text" %} 

    <div class="metaobject-pdp__items metaobject-pdp__items--columns-{{ block.settings.columns | default: 1 }}">
      {%- for item in metaobject_list.value -%}
        {% content_for 'block',
          type: '_meta-group',
          id: 'metastatic-img',
          item: item
        %}
      {%- endfor -%} 
    </div>
  </div>
{%- endif -%}
</div>

{% schema %}
{
  "name": "Sale Metaobjects",
  "tag": null,
  "class": "metaobject-pdp-block",
  "blocks": [
    {
      "type": "text",
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "display",
      "label": "Display",
      "options": [
        {
          "value": "all",
          "label": "Show on all devices"
        },
        {
          "value": "desktop-hidden",
          "label": "Hidden on desktop"
        },
        {
          "value": "mobile-hidden",
          "label": "Hidden on mobile"
        }
      ],
      "default": "all"
    },
   
    {
      "type": "metaobject",
      "id": "representative",
      "metaobject_type": "sale_representatives",
      "label": "Representative"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "info": "Number of columns to display on desktop. Mobile is always 1 column."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != \"none\" }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != \"none\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.1_mobile_padding"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_padding",
      "label": "t:settings.1_use_mobile_padding",
      "default": false,
      "info": "t:info.1_use_mobile_padding"
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.1_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.1_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start-mobile",
      "label": "t:settings.1_left_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end-mobile",
      "label": "t:settings.1_right_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_padding == true }}"
    }
  ],
  "presets": [
    {
      "name": "Sale Metaobjects",
      "category": "Sale"
    }
  ]
}
{% endschema %}
