<div
  class="featured-collection-block"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:names.featured_collection",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "display",
      "label": "Display",
      "options": [
        {
          "value": "all",
          "label": "Show on all devices"
        },
        {
          "value": "desktop-hidden",
          "label": "Hidden on desktop"
        },
        {
          "value": "mobile-hidden",
          "label": "Hidden on mobile"
        }
      ],
      "default": "all"
    },
   
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    }
  ],
  "presets": []
}
{% endschema %}
