{%- liquid
  # Get icon with text metaobjects from product
  assign icon_text_items = product.metafields.custom.icon_with_text_and_description.value
-%} 

{% stylesheet %}
  .product-metafield-icon-text {
    width: 100%;
  }

  .product-metafield-icon-text__grid {
    display: grid;
    gap: var(--grid-gap, 20px);
    grid-template-columns: repeat(var(--columns-desktop, 4), 1fr);
  }

  /* Mobile: Always single column */
  @media screen and (max-width: 749px) {
    .product-metafield-icon-text__grid {
      grid-template-columns: 1fr;
    }
  }

  .product-metafield-icon-text__item {
    display: flex;
    flex-direction: column;
    gap: var(--item-gap, 12px);
  }

  .product-metafield-icon-text__item .item-icon {
    width: var(--icon-size);
    height: var(--icon-size);
  }

  .product-metafield-icon-text__item .item-icon svg {
    width: 100%;
    height: 100%;
  }

  .product-metafield-icon-text__item .item-title {
    margin: 0;
  }

  .product-metafield-icon-text__item .item-description {
    margin: 0;
  }

  /* Typography presets */
  .product-metafield-icon-text__item .h1 {
    font-family: var(--font-h1--family);
    font-size: var(--font-h1--size);
    font-weight: var(--font-h1--weight);
    line-height: var(--font-h1--line-height);
    text-transform: var(--font-h1--case);
  }

  .product-metafield-icon-text__item .h2 {
    font-family: var(--font-h2--family);
    font-size: var(--font-h2--size);
    font-weight: var(--font-h2--weight);
    line-height: var(--font-h2--line-height);
    text-transform: var(--font-h2--case);
  }

  .product-metafield-icon-text__item .h3 {
    font-family: var(--font-h3--family);
    font-size: var(--font-h3--size);
    font-weight: var(--font-h3--weight);
    line-height: var(--font-h3--line-height);
    text-transform: var(--font-h3--case);
  }

  .product-metafield-icon-text__item .h4 {
    font-family: var(--font-h4--family);
    font-size: var(--font-h4--size);
    font-weight: var(--font-h4--weight);
    line-height: var(--font-h4--line-height);
    text-transform: var(--font-h4--case);
  }

  .product-metafield-icon-text__item .h5 {
    font-family: var(--font-h5--family);
    font-size: var(--font-h5--size);
    font-weight: var(--font-h5--weight);
    line-height: var(--font-h5--line-height);
    text-transform: var(--font-h5--case);
  }

  .product-metafield-icon-text__item .h6 {
    font-family: var(--font-h6--family);
    font-size: var(--font-h6--size);
    font-weight: var(--font-h6--weight);
    line-height: var(--font-h6--line-height);
    text-transform: var(--font-h6--case);
  }

  .product-metafield-icon-text__item .paragraph {
    font-family: var(--font-paragraph--family);
    font-size: var(--font-paragraph--size);
    font-weight: var(--font-paragraph--weight);
    line-height: var(--font-paragraph--line-height);
  }
{% endstylesheet %}

{%- if icon_text_items != blank -%}
  <div
    class="product-metafield-icon-text spacing-style border-style{% if block.settings.inherit_color_scheme == false %} color-{{ block.settings.color_scheme }}{% endif %}"
    style="
      --grid-gap: {{ block.settings.gap }}px;
      --item-gap: {{ block.settings.item_gap }}px;
      --columns-desktop: {{ block.settings.columns }};
      {% render 'spacing-style', settings: block.settings %}
      {% render 'border-override', settings: block.settings %}
    "
    {{ block.shopify_attributes }}
  >
    <div class="product-metafield-icon-text__grid">
      {%- for item in icon_text_items -%}
        <div
          class="product-metafield-icon-text__item"
          style="
            --icon-size: {{ block.settings.icon_size }}px;
            text-align: {{ block.settings.text_alignment }};
          "
        >
          {% content_for 'block', type: '_product-textico-metaobject', id: 'staticgrouptextico', item: item %}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- else -%}
    <div class="placeholder-message">
      <p>No icon with text items found. Add metaobjects to the product to display them here.</p>
    </div>
{%- endif -%}

{% schema %}
{
  "name": "Product Icon/Text Grid",
  "tag": null,
  "class": "product-metafield-icon-text-block",
  "settings": [
    {
      "type": "select",
      "id": "display",
      "label": "Display",
      "options": [
        {
          "value": "all",
          "label": "Show on all devices"
        },
        {
          "value": "desktop-hidden",
          "label": "Hidden on desktop"
        },
        {
          "value": "mobile-hidden",
          "label": "Hidden on mobile"
        }
      ],
      "default": "all"
    },
   
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "paragraph",
      "content": "Displays icon with text items from product.metafields.custom.icon_with_text_and_description"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "info": "Number of columns to display on desktop. Mobile is always 1 column."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap inside items",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 12,
      "info": "Space between icon, title, and description within each item"
    },
    {
      "type": "header",
      "content": "Icon Settings"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "icon_alignment",
      "label": "Icon alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "title_preset",
      "label": "Title preset",
      "options": [
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "description_preset",
      "label": "Description preset",
      "options": [
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        }
      ],
      "default": "paragraph"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != \"none\" }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != \"none\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Icon/Text Grid",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
