{% render 'button', link: block.settings.link %}

{% schema %}
{
  "name": "t:names.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "link",
          "label": "t:options.link"
        }
      ],
      "default": "button"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "default",
      "info": "Controls the button padding and height"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_desktop",
      "label": "Font (Desktop)",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "subheading",
          "label": "Subheading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font Size (Desktop)",
      "min": 10,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.font_desktop != 'default' }}"
    },
    {
      "type": "select",
      "id": "font_mobile",
      "label": "Font (Mobile)",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "subheading",
          "label": "Subheading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font Size (Mobile)",
      "min": 10,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 14,
      "visible_if": "{{ block.settings.font_mobile != 'default' }}"
    },
    {
      "type": "header",
      "content": "Link Styling"
    },
    {
      "type": "checkbox",
      "id": "show_underline",
      "label": "Show underline for link style",
      "default": false,
      "info": "Adds an animated underline effect to links",
      "visible_if": "{{ block.settings.style_class == 'link' }}"
    },
    {
      "type": "range",
      "id": "underline_thickness",
      "label": "Underline Thickness",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.style_class == 'link' and block.settings.show_underline }}"
    },
    {
      "type": "range",
      "id": "underline_offset",
      "label": "Underline Offset",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2,
      "info": "Distance between text and underline",
      "visible_if": "{{ block.settings.style_class == 'link' and block.settings.show_underline }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.button",
      "category": "t:categories.basic",
      "settings": {
        "link": "shopify://collections/all"
      }
    }
  ]
}
{% endschema %}
