<div class="block-visibility block-visibility--{{ block.settings.display }}">
{% assign block_settings = block.settings %}
<div
  class="accordion accordion--{{ block.id }} accordion--{{ block_settings.icon }} border-style spacing-style{% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}{% if block_settings.dividers %} accordion--dividers{% endif %}"
  style="
    --summary-font-family: var(--font-{{ block_settings.type_preset }}--family);
     --summary-font-style: var(--font-{{ block_settings.type_preset }}--style);
     --summary-font-weight: var(--font-{{ block_settings.type_preset }}--weight);
     --summary-font-size: var(--font-{{ block_settings.type_preset }}--size);
     --summary-font-line-height: var(--font-{{ block_settings.type_preset }}--line-height);
     --summary-font-case: var(--font-{{ block_settings.type_preset }}--case);
     --summary-color: var(--font-{{ block_settings.type_preset }}--color);
    {% render 'spacing-style', settings: block_settings %}
    {% render 'border-override', settings: block_settings %}
  "
  {{ block.shopify_attributes }}>
  {% assign meta_item_design = metaobjects.product_design_template.values %}

  {% comment %} Collect unique categories {% endcomment %}
  {% assign categories = '' %}
  {% for item in meta_item_design %}
    {% assign item_category = item.category | default: 'Uncategorized' %}
    {% unless categories contains item_category %}
      {% if categories != '' %}
        {% assign categories = categories | append: '|||' %}
      {% endif %}
      {% assign categories = categories | append: item_category %}
    {% endunless %}
  {% endfor %}
  {% assign categories_array = categories | split: '|||' %}

  {% comment %} Loop through each category and create accordion for each {% endcomment %}
  {% for category in categories_array %}
    <accordion-custom class="accordion_product-meta"
      {% if block_settings.open_by_default and forloop.first %}
        open-by-default-on-desktop
        open-by-default-on-mobile
      {% endif %}
    >
      <details class="details details_product-meta" data-testid="accordion-details">
        <summary class="details__header">
          {{ category }}
          <span class="svg-wrapper icon-caret icon-animated">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper icon-plus">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
        </summary>

        <div class="details-content">
          <div class="accordion-items-list">
            {% for item in meta_item_design %}
              {% assign item_category = item.category | default: 'Uncategorized' %}
              {% if item_category == category %}
                {% assign design_item_file = item.file | file_url %}
                {% assign fallback_label = item.file_name | default: 'PDF' %}
                {% content_for 'block', id: 'fileGroupDesign', type: '_meta-group-product-detail', item: item, fallback_link: design_item_file, fallback_label: fallback_label %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </details>
    </accordion-custom>
  {% endfor %}
</div>

{% stylesheet %}
  .accordion {
    flex: 1;
    width: 100%;
  }

  .accordion_product-meta {
    background-color: #ffffff;
    padding: 12.8px 12px;
    border-radius: 10px;
    border: 1px solid #cccccc;
    &:not(:last-child){
      margin-bottom: 12px;
    }
  }

  @media screen and (min-width: 750px){
    .accordion_product-meta {
      padding: 12.8px 24px;
    }
  }

  .accordion accordion-custom.accordion_product-meta {
    display: block;
  }
  .accordion--dividers accordion-custom details{
    border-radius: 0;
    border-top: 1px solid #ccc;
  }

  .accordion accordion-custom.accordion_product-meta:last-child details {
    display: block;
    border-bottom: none;
  }

  .accordion--dividers accordion-custom details summary {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .accordion--dividers accordion-custom details .details-content {
    padding-left: 0rem;
    padding-right: 0rem;
  }

  /* When accordion borders are not set, show fallback borders */
  .accordion--dividers {
    /* stylelint-disable-next-line declaration-property-value-disallowed-list */
    --show-fallback-borders: 0;
  }

  .accordion--dividers:not([class*='color-'])[style*='--border-width: 0'],
  .accordion--dividers:not([class*='color-'])[style*='--border-style: none'] {
    --show-fallback-borders: 1;
  }

  .accordion--dividers .details-content {
    padding-block-end: var(--padding-sm);
  }

  .accordion--caret .icon-plus,
  .accordion--plus .icon-caret {
    display: none;
  }

  /* because we can't pass apply a specific class on a block based on its parent block setting */
  .accordion .details__header {
    font-family: var(--summary-font-family);
    font-style: var(--summary-font-style);
    font-weight: var(--summary-font-weight);
    font-size: var(--summary-font-size);
    line-height: var(--summary-font-line-height);
    text-transform: var(--summary-font-case);
    color: var(--summary-color);
    min-height: var(--minimum-touch-target);
  }

  .accordion-items-list {
    --list-gap: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--list-gap);
  }

  @media screen and (min-width: 750px) {
    .accordion-items-list {
      flex-direction: row;
    }
  }

  @media screen and (max-width: 749px) {
    .accordion-items-list {
      flex-direction: column;
    }
  }

  .accordion-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgb(var(--color-border-rgb) / var(--opacity-20));
  }

  .accordion-item:last-child {
    border-bottom: none;
  }

  .accordion-item__title {
    font-weight: 500;
  }

  .accordion-item__file img {
    max-width: 200px;
    height: auto;
  }

  .accordion-item__download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  accordion-custom details .details-content .accordion-items-list {
    padding-top: 10px; 
    padding-bottom: 12px;
  }

  .details-content .accordion-items-list > div {
    flex: 0 0 100%;
  }

  @media screen and (min-width: 750px) {
    .details-content .accordion-items-list > div {
      flex: 0 0 calc(50% - var(--list-gap) / 2);
    }
  }
{% endstylesheet %}
</div>

{% schema %}
{
  "name": "Design Template Meta",
  "tag": null,
  "class": "accordion",
  "settings": [
    {
      "type": "select",
      "id": "display",
      "label": "Display",
      "options": [
        {
          "value": "all",
          "label": "Show on all devices"
        },
        {
          "value": "desktop-hidden",
          "label": "Hidden on desktop"
        },
        {
          "value": "mobile-hidden",
          "label": "Hidden on mobile"
        }
      ],
      "default": "all"
    },
   
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "caret",
          "label": "t:options.caret"
        },
        {
          "value": "plus",
          "label": "t:options.plus"
        }
      ],
      "default": "caret"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "t:settings.open_row_by_default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "dividers",
      "label": "t:settings.dividers",
      "default": true
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.heading_preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "h6",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != \"none\" }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != \"none\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.1_mobile_padding"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_padding",
      "label": "t:settings.1_use_mobile_padding",
      "default": false,
      "info": "t:info.1_use_mobile_padding"
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.1_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.1_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start-mobile",
      "label": "t:settings.1_left_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end-mobile",
      "label": "t:settings.1_right_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_padding == true }}"
    }
  ],
  "presets": [
    {
      "name": "Design Template Meta",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
