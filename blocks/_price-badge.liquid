{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign selected_variant = product_resource.selected_or_first_available_variant
-%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    endif
    if block_settings.background
      echo ' text-block--background'
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

{%- liquid
  assign show_price_min = block_settings.show_price_min | default: false

  # Determine if we should show minimum price with "From" prefix
  assign use_price_min = show_price_min

  # Set price values based on whether we're showing min price or selected variant price
  if use_price_min
    assign price_raw = product_resource.price_min
    assign compare_at_price_raw = product_resource.compare_at_price_min
  else
    assign price_raw = selected_variant.price
    assign compare_at_price_raw = selected_variant.compare_at_price
  endif

  assign show_compare_price = false
  if compare_at_price_raw > price_raw
    assign show_compare_price = true
  endif

  # Calculate save value
  assign save_value_text = ''
  if show_compare_price
    assign save_amount = compare_at_price_raw | minus: price_raw
    if block_settings.save_value_type == 'percent'
      assign save_percent = save_amount | times: 100.0 | divided_by: compare_at_price_raw | round
      assign save_value_text = block_settings.save_prefix | append: ' ' | append: save_percent | append: '%'
    else
      assign save_amount_formatted = save_amount | money
      assign save_value_text = block_settings.save_prefix | append: ' ' | append: save_amount_formatted
    endif
  endif
-%}

<div
  class="text-block {{ text_block_classes }} text-{{ block_settings.alignment }} {{ block_settings.type_preset | default: 'paragraph' }} spacing-style price-badge-block"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product_resource.id }}"
  style="
    {% render 'typography-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --width: {{ block_settings.width }};
  "
  {{ block.shopify_attributes }}
>
  {% if save_value_text == blank or save_value_text == '' %}<div class="block-hidden"></div>{% endif %}
  <div ref="badgeContainer">
    {% if show_compare_price and save_value_text != '' %}
      <span class="save-badge" style="
        display: inline-block;
        padding: {{ block_settings.save_badge_padding_block }}px {{ block_settings.save_badge_padding_inline }}px;
        border-radius: {{ block_settings.save_badge_border_radius }}px;
        background-color: {{ block_settings.save_badge_background }};
        color: {{ block_settings.save_badge_text_color }};
        --save-badge-font-size: {{ block_settings.save_badge_font_size }}px;
        --save-badge-font-size-mobile: {{ block_settings.save_badge_font_size_mobile }}px;
        font-size: var(--save-badge-font-size);
        font-weight: {{ block_settings.save_badge_font_weight }};
        text-transform: {{ block_settings.save_badge_text_transform }};
        white-space: nowrap;
      ">{{ save_value_text }}</span>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  @media screen and (max-width: 749px) {
    .save-badge {
      font-size: var(--save-badge-font-size-mobile) !important;
    }
  }
{% endstylesheet %}

{% # theme-check-disable %}

