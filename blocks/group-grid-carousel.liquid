{% capture list_items %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'group-grid-carousel', list_items: list_items, settings: block.settings, shopify_attributes: block.shopify_attributes %}

{% stylesheet %}
  /* Custom dot styles */
  .slideshow-controls__dots--custom {
    mix-blend-mode: normal;

    button {
      --color: var(--dot-bg-color, #ffffff);
      --color-active: var(--dot-active-bg-color, #000000);
      --color-hover: var(--dot-bg-color, #ffffff);

      &::after {
        background: var(--dot-bg-color, #ffffff);
        border: 1px solid var(--dot-border-color, #000000);
      }

      &:hover::after {
        background: var(--dot-bg-color, #ffffff);
        border-color: var(--dot-border-color, #000000);
      }

      &[aria-selected='true'] {
        --color: var(--dot-active-bg-color, #000000);

        &::after {
          background: var(--dot-active-bg-color, #000000);
          border-color: var(--dot-active-border-color, #000000);
        }
      }
    }
  }

  /* Override mix-blend-mode for custom dots */
  slideshow-controls:has(.slideshow-controls__dots--custom) {
    mix-blend-mode: normal;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Group (Grid/Carousel)",
  "class": "grid-carousel-group",
  "blocks": [
    {
      "type": "_group-item"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout Type",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "layout_type_mobile",
      "label": "Mobile Layout Type",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile Columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2",
      "visible_if": "{{ block.settings.layout_type_mobile == 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "Show Peek on Mobile",
      "info": "Show 90% slide width with peek of next slide",
      "default": false,
      "visible_if": "{{ block.settings.layout_type_mobile == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Horizontal Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "Vertical Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.layout_type == 'grid'}}"
    },
    {
      "type": "header",
      "content": "Carousel Navigation",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.layout_type_mobile == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto Rotate Slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Speed",
      "min": 3,
      "max": 7,
      "step": 1,
      "unit": "s",
      "default": 4,
      "visible_if": "{{ block.settings.autoplay }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Icon",
      "options": [
        {
          "value": "arrow",
          "label": "Arrows"
        },
        {
          "value": "chevron",
          "label": "Chevrons"
        },
        {
          "value": "arrows_large",
          "label": "Arrows Large"
        },
        {
          "value": "chevron_large",
          "label": "Chevron Large"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.layout_type_mobile == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slideshow_controls_position",
      "label": "Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.layout_type_mobile == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Icon Background",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.icons_style != 'none' and block.settings.layout_type == 'carousel' or block.settings.layout_type_mobile == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "icons_style_mobile",
      "label": "Mobile Icon",
      "options": [
        {
          "value": "arrow",
          "label": "Arrows"
        },
        {
          "value": "chevron",
          "label": "Chevrons"
        },
        {
          "value": "arrows_large",
          "label": "Arrows Large"
        },
        {
          "value": "chevron_large",
          "label": "Chevron Large"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.layout_type_mobile == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slideshow_controls_style",
      "label": "Pagination",
      "options": [
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "counter",
          "label": "Counter"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slideshow_mobile_controls_style",
      "label": "Mobile Pagination",
      "options": [
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "counter",
          "label": "Counter"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.layout_type_mobile == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "dot_style_type",
      "label": "Dot Style",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.slideshow_controls_style == 'dots' or block.settings.slideshow_mobile_controls_style == 'dots' }}"
    },
    {
      "type": "color",
      "id": "dot_background_color",
      "label": "Dot Background Color",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.dot_style_type == 'custom' }}"
    },
    {
      "type": "color",
      "id": "dot_active_background_color",
      "label": "Dot Active Background Color",
      "default": "#000000",
      "visible_if": "{{ block.settings.dot_style_type == 'custom' }}"
    },
    {
      "type": "color",
      "id": "dot_border_color",
      "label": "Dot Border Color",
      "default": "#000000",
      "visible_if": "{{ block.settings.dot_style_type == 'custom' }}"
    },
    {
      "type": "color",
      "id": "dot_active_border_color",
      "label": "Dot Active Border Color",
      "default": "#000000",
      "visible_if": "{{ block.settings.dot_style_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "Inherit Color Scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "text",
      "id": "carousel_custom_class",
      "label": "Custom Class",
      "info": "Separate with space for custom class"
    }
  ],
  "presets": [
    {
      "name": "Group Grid",
      "category": "Layout",
      "settings": {}
    }
  ]
}
{% endschema %}
