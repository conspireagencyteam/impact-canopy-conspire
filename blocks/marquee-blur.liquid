<div class="block-visibility block-visibility--{{ block.settings.display }}">
<script
  src="{{ 'marquee-blur.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% assign block_settings = block.settings %}
{% assign gap_between_elements = block_settings.gap_between_elements %}
{% assign sizing_mode = block_settings.sizing_mode | default: 'column' %}

<marquee-blur-component
  class="
    marquee-blur
    spacing-style
    gap-style
    {% if sizing_mode == 'item_width' %}marquee-blur--custom-size{% endif %}
    {% if block_settings.inherit_color_scheme == false %}color-{{ block_settings.color_scheme }}{% endif %}
  "
  style="
    {%- render 'spacing-style', settings: block_settings %};
    {% render 'gap-style', value: gap_between_elements, name: 'marquee-gap' %}
    --marquee-direction: {{ block_settings.movement_direction }};
    --blur-width: {{ block_settings.blur_width }}%;
    --blur-intensity: {{ block_settings.blur_intensity }}px;
    --columns-desktop: {{ block_settings.columns_desktop }};
    --columns-mobile: {{ block_settings.columns_mobile }};
    --item-width-desktop: {{ block_settings.item_width_desktop | default: 300 }}px;
    --item-width-mobile: {{ block_settings.item_width_mobile | default: 200 }}px;
    --item-height-desktop: {% if block_settings.item_height_desktop > 0 %}{{ block_settings.item_height_desktop }}px{% else %}auto{% endif %};
    --item-height-mobile: {% if block_settings.item_height_mobile > 0 %}{{ block_settings.item_height_mobile }}px{% else %}auto{% endif %};
    {%- if block_settings.transparent_background == true -%}background-color: transparent;{%- endif -%}
  "
  data-speed-factor="{{ block_settings.speed_factor }}"
  data-movement-direction="{{ block_settings.movement_direction }}"
  data-columns-desktop="{{ block_settings.columns_desktop }}"
  data-columns-mobile="{{ block_settings.columns_mobile }}"
  data-sizing-mode="{{ sizing_mode }}"
>
  <div class="marquee-blur__blur-overlay marquee-blur__blur-overlay--left"></div>
  <div class="marquee-blur__blur-overlay marquee-blur__blur-overlay--right"></div>

  <div
    class="marquee-blur__wrapper"
    ref="wrapper"
  >
    <div
      class="marquee-blur__content"
      ref="content"
    >
      <div
        class="marquee-blur__repeated-items"
        ref="marqueeItems"
      >
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</marquee-blur-component>

{% stylesheet %}
  marquee-blur-component {
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-background);
    position: relative;
  }

  .marquee-blur__blur-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--blur-width, 15%);
    z-index: 2;
    pointer-events: none;
  }

  .marquee-blur__blur-overlay--left {
    left: 0;
    background: linear-gradient(
      to right,
      var(--color-background, #fff) 0%,
      transparent 100%
    );
  }

  .marquee-blur__blur-overlay--right {
    right: 0;
    background: linear-gradient(
      to left,
      var(--color-background, #fff) 0%,
      transparent 100%
    );
  }

  .marquee-blur__wrapper {
    display: flex;
    gap: var(--marquee-gap);
    width: fit-content;
    white-space: nowrap;
  }

  .marquee-blur__content {
    min-width: 100vw;
    display: flex;
    gap: var(--marquee-gap);
  }

  .marquee-blur__content :is(p, h1, h2, h3, h4, h5, h6) {
    white-space: nowrap;
  }

  .marquee-blur__repeated-items {
    display: flex;
    gap: var(--marquee-gap);
    align-items: center;
    min-width: 100vw;
  }

  /* Column-based sizing (default) - Each item takes equal width based on columns */
  marquee-blur-component:not(.marquee-blur--custom-size) .marquee-blur__repeated-items > .marquee-item {
    flex: 0 0 calc((100vw - (var(--columns-mobile, 3) - 1) * var(--marquee-gap, 48px)) / var(--columns-mobile, 3));
    max-width: calc((100vw - (var(--columns-mobile, 3) - 1) * var(--marquee-gap, 48px)) / var(--columns-mobile, 3));
  }

  @media screen and (min-width: 990px) {
    marquee-blur-component:not(.marquee-blur--custom-size) .marquee-blur__repeated-items > .marquee-item {
      flex: 0 0 calc((100vw - (var(--columns-desktop, 8) - 1) * var(--marquee-gap, 48px)) / var(--columns-desktop, 8));
      max-width: calc((100vw - (var(--columns-desktop, 8) - 1) * var(--marquee-gap, 48px)) / var(--columns-desktop, 8));
    }
  }

  /* Custom item size mode */
  .marquee-blur--custom-size .marquee-blur__repeated-items {
    min-width: auto;
  }

  .marquee-blur__repeated-items .image-block {
    width: 100%;
    height: 100%;
    img {
      object-fit: contain;
    }
  }

  .marquee-blur--custom-size .marquee-blur__content {
    min-width: auto;
  }

  .marquee-blur--custom-size .marquee-blur__repeated-items > .marquee-item {
    flex: 0 0 var(--item-width-mobile, 200px);
    width: var(--item-width-mobile, 200px);
    max-width: var(--item-width-mobile, 200px);
    height: var(--item-height-mobile, auto);
  }

  @media screen and (min-width: 990px) {
    .marquee-blur--custom-size .marquee-blur__repeated-items > .marquee-item {
      flex: 0 0 var(--item-width-desktop, 300px);
      width: var(--item-width-desktop, 300px);
      max-width: var(--item-width-desktop, 300px);
      height: var(--item-height-desktop, auto);
    }
  }

  .marquee-blur__repeated-items > * {
    align-content: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    marquee-blur-component:not([data-disabled]) .marquee-blur__wrapper {
      animation: marquee-blur-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }
  }

  @keyframes marquee-blur-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }
{% endstylesheet %}
</div>

