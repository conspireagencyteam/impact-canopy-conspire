{% assign block_settings = block.settings %}

{% if block_settings.button_type == 'popup' %}
  <script
    src="{{ 'dialog.js' | asset_url }}"
    type="module"
  ></script>

  {% liquid
    # Submit button label - use custom if provided, otherwise use translation
    assign submit_button_label = block_settings.submit_label
    if submit_button_label == blank
      assign submit_button_label = 'blocks.contact_form.submit' | t
    endif
  %}

  {% liquid
    # Typography variables
    assign font_desktop = block_settings.font_desktop | default: 'default'
    assign font_mobile = block_settings.font_mobile | default: 'default'
    assign font_size_desktop = block_settings.font_size_desktop
    assign font_size_mobile = block_settings.font_size_mobile

    # Underline variables
    assign show_underline = block_settings.show_underline | default: false
    assign underline_thickness = block_settings.underline_thickness | default: 1
    assign underline_offset = block_settings.underline_offset | default: 2
    assign button_size = block_settings.button_size | default: "default"

    # Icon variables
    assign icon = block_settings.icon | default: 'none'
    assign icon_image = block_settings.icon_image
    assign icon_size = block_settings.icon_size | default: 20
    assign icon_position = block_settings.icon_position | default: 'left'
    assign has_icon = false
    if icon != 'none' or icon_image != blank
      assign has_icon = true
    endif

    # Build custom style string
    assign custom_style = ''

    # Add typography styles
    if font_desktop != 'default'
      assign custom_style = custom_style | append: '--font-family-override-desktop: var(--font-' | append: font_desktop | append: '); '
      if font_size_desktop
        assign custom_style = custom_style | append: '--font-size-override-desktop: ' | append: font_size_desktop | append: 'px; '
      endif
    endif

    if font_mobile != 'default'
      assign custom_style = custom_style | append: '--font-family-override-mobile: var(--font-' | append: font_mobile | append: '); '
      if font_size_mobile
        assign custom_style = custom_style | append: '--font-size-override-mobile: ' | append: font_size_mobile | append: 'px; '
      endif
    endif

    # Add underline styles
    if show_underline and block_settings.style_class == 'link'
      assign custom_style = custom_style | append: '--underline-thickness: ' | append: underline_thickness | append: 'px; '
      assign custom_style = custom_style | append: '--underline-offset: ' | append: underline_offset | append: 'px; '
    endif
  %}

  <dialog-component
    class="contact-form-button-popup"
    {{ block.shopify_attributes }}
  >
    <button
      type="button"
      on:click="/showDialog"
      class="
        size-style
        {{ block_settings.style_class }}
        button--{{ button_size }}
        {{ block_settings.style_class }}--{{ block.id }}
        {% if show_underline and block_settings.style_class == 'link' %}link--underline{% endif %}
        {% if has_icon %}button--has-icon button--icon-{{ icon_position }}{% endif %}
      "
      style="{% render 'size-style', settings: block_settings %}{{ custom_style }}"
    >
      {%- if has_icon and icon_position == 'left' -%}
        {% render 'icon-or-image',
          icon: icon,
          image_upload: icon_image,
          width: icon_size,
          class_name: 'button__icon'
        %}
      {%- endif -%}
      <span class="button__label">{{ block_settings.label }}</span>
      {%- if has_icon and icon_position == 'right' -%}
        {% render 'icon-or-image',
          icon: icon,
          image_upload: icon_image,
          width: icon_size,
          class_name: 'button__icon'
        %}
      {%- endif -%}
    </button>

    <dialog
      ref="dialog"
      class="contact-form-button-popup__dialog dialog-modal color-{{ settings.popover_color_scheme }}{% if block_settings.popup_behavior == 'drawer' %} contact-form-button-popup__dialog--drawer dialog-drawer{% endif %}"
      scroll-lock
      aria-labelledby="contact-form-dialog-heading-{{ block.id }}"
    >
      <h2
        id="contact-form-dialog-heading-{{ block.id }}"
        class="contact-form-button-popup__heading h3"
      >
        {{ block_settings.popup_heading }}
      </h2>
      <div class="contact-form-button-popup__inner">
        {% assign form_id = block.id | prepend: 'ContactFormPopup-' %}

        <div class="contact-form-button-popup__message contact-form-button-popup__message--error" id="contact-form-error-{{ block.id }}" style="display: none;">
          {{- 'icon-error.svg' | inline_asset_content -}}
          <span id="contact-form-error-text-{{ block.id }}">{{ 'blocks.contact_form.error' | t | default: 'Please enter a valid email address.' }}</span>
        </div>

        <div class="contact-form-button-popup__message contact-form-button-popup__message--success" id="contact-form-success-{{ block.id }}" style="display: none;">
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
          <span>{{ 'blocks.contact_form.post_success' | t }}</span>
        </div>

        <iframe
          name="contact-form-iframe-{{ block.id }}"
          id="contact-form-iframe-{{ block.id }}"
          style="display: none; position: absolute; width: 0; height: 0; border: 0;"
        ></iframe>

        <form
          method="post"
          action="/contact#{{ form_id }}"
          id="{{ form_id }}"
          accept-charset="UTF-8"
          class="contact-form__form contact-form-button-popup__form"
          target="contact-form-iframe-{{ block.id }}"
        >
          <input type="hidden" name="form_type" value="contact">
          <input type="hidden" name="utf8" value="✓">

          <div class="contact-form__form-row">
            <label
              class="visually-hidden"
              for="ContactFormPopup-name-{{ block.id }}"
            >
              {{- 'blocks.contact_form.name' | t -}}
            </label>
            <input
              type="text"
              id="ContactFormPopup-name-{{ block.id }}"
              class="contact-form__input"
              autocomplete="name"
              name="contact[name]"
              value="{% if customer %}{{ customer.name }}{% endif %}"
              placeholder="{{ 'blocks.contact_form.name' | t }}"
            >

            <label
              class="visually-hidden"
              for="ContactFormPopup-email-{{ block.id }}"
            >
              {{- 'blocks.contact_form.email' | t -}}
              <span aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="ContactFormPopup-email-{{ block.id }}"
              class="contact-form__input"
              autocomplete="email"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              required
              placeholder="{{ 'blocks.contact_form.email' | t }}"
            >
          </div>

          <label
            class="visually-hidden"
            for="ContactFormPopup-phone-{{ block.id }}"
          >
            {{- 'blocks.contact_form.phone' | t -}}
          </label>
          <input
            type="tel"
            id="ContactFormPopup-phone-{{ block.id }}"
            class="contact-form__input"
            autocomplete="tel"
            name="contact[phone]"
            value="{% if customer %}{{ customer.phone }}{% endif %}"
            placeholder="{{ 'blocks.contact_form.phone' | t }}"
          >

          <label
            class="visually-hidden"
            for="ContactFormPopup-body-{{ block.id }}"
          >
            {{- 'blocks.contact_form.comment' | t -}}
          </label>
          <textarea
            rows="10"
            id="ContactFormPopup-body-{{ block.id }}"
            class="contact-form__input contact-form__input--textarea"
            name="contact[body]"
            placeholder="{{ 'blocks.contact_form.comment' | t }}"
          ></textarea>

          <button type="submit" id="contact-form-submit-{{ block.id }}" class="button contact-form-button-popup__submit">
            <span class="contact-form-button-popup__submit-text">{{ submit_button_label }}</span>
            <span class="contact-form-button-popup__submit-loading" style="display: none;">
              {{ 'accessibility.loading' | t | default: 'Loading...' }}
            </span>
          </button>
        </form>
      </div>
      <button
        ref="closeButton"
        on:click="/closeDialog"
        class="button button-unstyled close-button contact-form-button-popup__close"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </dialog>
  </dialog-component>

  <script>
    (function() {
      // Scoped to this specific contact form button block: {{ block.id }}
      function initContactFormPopup_{{ block.id | replace: '-', '_' }}() {
        const formId = 'ContactFormPopup-{{ block.id }}';
        const form = document.getElementById(formId);
        const iframe = document.getElementById('contact-form-iframe-{{ block.id }}');
        if (!form || form.dataset.initialized) return;
        form.dataset.initialized = 'true';

        const successEl = document.getElementById('contact-form-success-{{ block.id }}');
        const errorEl = document.getElementById('contact-form-error-{{ block.id }}');
        const errorTextEl = document.getElementById('contact-form-error-text-{{ block.id }}');
        const submitBtn = document.getElementById('contact-form-submit-{{ block.id }}');
        const submitText = submitBtn ? submitBtn.querySelector('.contact-form-button-popup__submit-text') : null;
        const submitLoading = submitBtn ? submitBtn.querySelector('.contact-form-button-popup__submit-loading') : null;

        let formSubmitting = false;

        // Listen to iframe load to detect form submission result
        if (iframe) {
          iframe.addEventListener('load', function() {
            // Only process if we initiated a form submission
            if (!formSubmitting) return;
            formSubmitting = false;

            // Reset button state
            if (submitBtn) submitBtn.disabled = false;
            if (submitText) submitText.style.display = 'inline';
            if (submitLoading) submitLoading.style.display = 'none';

            try {
              // Try to access iframe content to check for success/error
              const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
              const iframeContent = iframeDoc.body ? iframeDoc.body.innerHTML : '';

              // Check for Shopify's success indicators
              if (iframeContent.includes('form--success') ||
                  iframeContent.includes('form-success') ||
                  iframeContent.includes('contact_form') && !iframeContent.includes('form--error')) {
                // Success
                if (successEl) successEl.style.display = 'flex';
                if (errorEl) errorEl.style.display = 'none';
                form.reset();
                form.style.display = 'none';
              } else if (iframeContent.includes('form--error') ||
                         iframeContent.includes('form-error') ||
                         iframeContent.includes('error')) {
                // Error in form
                if (errorEl) errorEl.style.display = 'flex';
                if (successEl) successEl.style.display = 'none';
                if (errorTextEl) errorTextEl.textContent = '{{ "blocks.contact_form.error" | t | default: "Please enter a valid email address." }}';
              } else {
                // Assume success if no error indicators found
                if (successEl) successEl.style.display = 'flex';
                if (errorEl) errorEl.style.display = 'none';
                form.reset();
                form.style.display = 'none';
              }
            } catch (e) {
              // Cross-origin error - can't access iframe content
              // This happens with captcha redirects or same-origin policy
              // Assume success since form was submitted
              if (successEl) successEl.style.display = 'flex';
              if (errorEl) errorEl.style.display = 'none';
              form.reset();
              form.style.display = 'none';
            }
          });
        }

        form.addEventListener('submit', function(e) {
          // Let the form submit to the iframe naturally
          formSubmitting = true;

          // Hide previous messages
          if (successEl) successEl.style.display = 'none';
          if (errorEl) errorEl.style.display = 'none';

          // Show loading state
          if (submitBtn) submitBtn.disabled = true;
          if (submitText) submitText.style.display = 'none';
          if (submitLoading) submitLoading.style.display = 'inline';

          // Set a timeout in case iframe load event doesn't fire
          setTimeout(function() {
            if (formSubmitting) {
              formSubmitting = false;
              // Reset button state
              if (submitBtn) submitBtn.disabled = false;
              if (submitText) submitText.style.display = 'inline';
              if (submitLoading) submitLoading.style.display = 'none';
              // Show success (form was submitted, we just couldn't detect response)
              if (successEl) successEl.style.display = 'flex';
              form.reset();
              form.style.display = 'none';
            }
          }, 10000); // 10 second timeout
        });
      }

      // iOS height detection for dialog
      function handleIOSDialogHeight_{{ block.id | replace: '-', '_' }}() {
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
                      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

        if (!isIOS) return;

        const dialog = document.querySelector('.contact-form-button-popup__dialog');
        if (!dialog) return;

        function checkHeight() {
          const viewportHeight = window.innerHeight;
          if (viewportHeight < 780) {
            dialog.classList.add('incontact-form-button-popup__dialog');
          } else {
            dialog.classList.remove('incontact-form-button-popup__dialog');
          }
        }

        checkHeight();
        window.addEventListener('resize', checkHeight);
        window.addEventListener('orientationchange', checkHeight);
      }

      // Initialize on DOMContentLoaded or immediately if already loaded
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          initContactFormPopup_{{ block.id | replace: '-', '_' }}();
          handleIOSDialogHeight_{{ block.id | replace: '-', '_' }}();
        });
      } else {
        initContactFormPopup_{{ block.id | replace: '-', '_' }}();
        handleIOSDialogHeight_{{ block.id | replace: '-', '_' }}();
      }
    })();
  </script>
{% else %}
  {% render 'button', link: block_settings.link %}
{% endif %}

{% stylesheet %}
  .contact-form-button-popup__dialog {
    box-shadow: var(--shadow-popover);
    border: var(--style-border-popover);
    border-radius: var(--style-border-radius-popover);
    background-color: var(--color-background);
    padding: var(--padding-4xl) var(--padding-xl) var(--padding-xl);
    max-width: var(--normal-content-width);
    max-height: var(--modal-max-height);
    width: 100%;

    @media screen and (min-width: 750px) {
      padding: var(--padding-5xl);
      min-width: 500px;
    }
  }

  .contact-form-button-popup__dialog[open] {
    animation: modalSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .contact-form-button-popup__dialog.dialog-closing {
    animation: modalSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .contact-form-button-popup__dialog--drawer {
    position: fixed;
    border-radius: 0;
    width: var(--sidebar-width);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;
  }

  .contact-form-button-popup__dialog--drawer:modal {
    max-height: 100dvh;
  }

  .contact-form-button-popup__close {
    top: var(--margin-2xs);
    right: var(--margin-2xs);
    opacity: 0.8;
    animation: none;
  }

  .contact-form-button-popup__heading {
    margin-bottom: var(--margin-lg);
  }

  .contact-form-button-popup__inner {
    overflow-y: auto;
  }

  .contact-form-button-popup__submit {
    width: 100%;
    margin-top: var(--margin-md);
  }

  .contact-form-button-popup__submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .contact-form-button-popup__message {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    padding: var(--padding-md);
    border-radius: var(--style-border-radius-inputs);
    margin-bottom: var(--margin-md);
  }

  .contact-form-button-popup__message[hidden] {
    display: none;
  }

  .contact-form-button-popup__message--success {
    background-color: rgb(0 128 0 / 10%);
    color: green;
  }

  .contact-form-button-popup__message--success svg {
    color: green;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .contact-form-button-popup__message--error {
    background-color: rgb(255 0 0 / 10%);
    color: #c00;
  }

  .contact-form-button-popup__message--error svg {
    color: #c00;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact Form Button",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Button Type"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Button type",
      "options": [
        {
          "value": "default",
          "label": "Default (URL link)"
        },
        {
          "value": "popup",
          "label": "Popup (Contact form)"
        }
      ],
      "default": "popup"
    },
    {
      "type": "header",
      "content": "Popup Settings",
      "visible_if": "{{ block.settings.button_type == 'popup' }}"
    },
    {
      "type": "select",
      "id": "popup_behavior",
      "label": "Popup behavior",
      "options": [
        {
          "value": "default",
          "label": "Modal (center)"
        },
        {
          "value": "drawer",
          "label": "Drawer (side)"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.button_type == 'popup' }}"
    },
    {
      "type": "text",
      "id": "popup_heading",
      "label": "Popup heading",
      "default": "Contact Us",
      "visible_if": "{{ block.settings.button_type == 'popup' }}"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Send Message",
      "visible_if": "{{ block.settings.button_type == 'popup' }}"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "visible_if": "{{ block.settings.button_type == 'default' }}"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false,
      "visible_if": "{{ block.settings.button_type == 'default' }}"
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "button-tertiary",
          "label": "Tertiary"
        },
        {
          "value": "link",
          "label": "t:options.link"
        }
      ],
      "default": "button"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "default",
      "info": "Controls the button padding and height"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Tablet width",
      "info": "Width for tablet devices (768px-1250px)",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_desktop",
      "label": "Font (Desktop)",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "subheading",
          "label": "Subheading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font Size (Desktop)",
      "min": 10,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.font_desktop != 'default' }}"
    },
    {
      "type": "select",
      "id": "font_mobile",
      "label": "Font (Mobile)",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "subheading",
          "label": "Subheading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font Size (Mobile)",
      "min": 10,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 14,
      "visible_if": "{{ block.settings.font_mobile != 'default' }}"
    },
    {
      "type": "header",
      "content": "Link Styling"
    },
    {
      "type": "checkbox",
      "id": "show_underline",
      "label": "Show underline for link style",
      "default": false,
      "info": "Adds an animated underline effect to links",
      "visible_if": "{{ block.settings.style_class == 'link' }}"
    },
    {
      "type": "range",
      "id": "underline_thickness",
      "label": "Underline Thickness",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.style_class == 'link' and block.settings.show_underline }}"
    },
    {
      "type": "range",
      "id": "underline_offset",
      "label": "Underline Offset",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2,
      "info": "Distance between text and underline",
      "visible_if": "{{ block.settings.style_class == 'link' and block.settings.show_underline }}"
