{%- liquid
  # Get FAQ metaobjects from product
  assign faq_items = product.metafields.custom.faq.value
-%}

<div
  class="product-accordion accordion accordion--{{ block.id }} accordion--{{ block.settings.icon }} border-style spacing-style{% if block.settings.inherit_color_scheme == false %} color-{{ block.settings.color_scheme }}{% endif %}{% if block.settings.dividers %} accordion--dividers{% endif %}"
  style="
    {% if block.settings.type_preset != 'custom' %}
      --summary-font-family: var(--font-{{ block.settings.type_preset }}--family);
      --summary-font-style: var(--font-{{ block.settings.type_preset }}--style);
      --summary-font-weight: var(--font-{{ block.settings.type_preset }}--weight);
      --summary-font-size: var(--font-{{ block.settings.type_preset }}--size);
      --summary-font-line-height: var(--font-{{ block.settings.type_preset }}--line-height);
      --summary-font-case: var(--font-{{ block.settings.type_preset }}--case);
    {% else %}
      --summary-font-family: {{ block.settings.font }};
      {% if block.settings.font_size != blank %}--summary-font-size: {{ block.settings.font_size }};{% endif %}
      --summary-font-line-height: var(--line-height-{{ block.settings.line_height }});
      --summary-font-letter-spacing: var(--letter-spacing-{{ block.settings.letter_spacing }});
      --summary-font-case: {{ block.settings.case }};
      --summary-font-wrap: {{ block.settings.wrap }};
    {% endif %}
    {% if block.settings.type_preset != 'rte' %}--summary-color: {{ block.settings.color }};{% endif %}
    {% if block.settings.custom_mobile_size and block.settings.font_size_mobile != blank %}--summary-font-size-mobile: {{ block.settings.font_size_mobile }};{% endif %}
    {% if block.settings.icon_color == "custom" and block.settings.icon_custom_color != blank %}--icon-color: {{ block.settings.icon_custom_color }};{% else %}--icon-color: {{ block.settings.icon_color }};{% endif %}
    --summary-padding-top: {{ block.settings.heading_padding_top }}px;
    --summary-padding-bottom: {{ block.settings.heading_padding_bottom }}px;
    --summary-padding-left: {{ block.settings.heading_padding_left }}px;
    --summary-padding-right: {{ block.settings.heading_padding_right }}px;
    {% render 'spacing-style', settings: block.settings %}
    {% render 'border-override', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  {%- if faq_items != blank -%}
    {%- for faq in faq_items -%}
      <accordion-custom {% if forloop.first and block.settings.open_first %}
        open-by-default-on-desktop
        open-by-default-on-mobile
      {% endif %}>
        <details class="details">
          <summary class="details__header">
            <span class="details__header-text">{{ faq.title }}</span>
            <span class="svg-wrapper icon-caret icon-animated">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
            <span class="svg-wrapper icon-plus">
              {{- 'icon-plus.svg' | inline_asset_content -}}
            </span>
          </summary>
          <div class="details-content rte">
            {{ faq.content | metafield_tag }}
          </div>
        </details>
      </accordion-custom>
    {%- endfor -%}
  {%- else -%}
    <div class="placeholder-message" style="padding: 2rem; text-align: center; opacity: 0.6;">
      <p>No FAQ items found. Add FAQ metaobjects to the product to display them here.</p>
      <p style="font-size: 0.875rem; margin-top: 0.5rem;">Product metafield: <code>product.metafields.custom.faq</code></p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-accordion {
    flex: 1;
    width: 100%;
  }

  .product-accordion .accordion--dividers accordion-custom:not(:first-child) .details {
    border-block-start: var(--style-border-width) solid var(--color-border);
  }

  /* When accordion borders are not set, show fallback borders */
  .product-accordion .accordion--dividers {
    /* stylelint-disable-next-line declaration-property-value-disallowed-list */
    --show-fallback-borders: 0;
  }

  .product-accordion .accordion--dividers:not([class*='color-'])[style*='--border-width: 0'],
  .product-accordion .accordion--dividers:not([class*='color-'])[style*='--border-style: none'] {
    --show-fallback-borders: 1;
  }

  .product-accordion .accordion--dividers accordion-custom:last-child .details {
    border-block-end: calc(var(--style-border-width) * var(--show-fallback-borders)) solid var(--color-border);
  }

  .product-accordion .accordion--dividers .details-content {
    padding-block-end: var(--padding-sm);
  }

  product-accordion .accordion--caret .icon-plus,
  product-accordion .accordion--plus .icon-caret {
    display: none;
  }

  /* because we can't pass apply a specific class on a block based on its parent block setting */
  .product-accordion.accordion .details__header {
    font-family: var(--summary-font-family);
    font-style: var(--summary-font-style);
    font-weight: var(--summary-font-weight);
    font-size: var(--summary-font-size);
    line-height: var(--summary-font-line-height);
    letter-spacing: var(--summary-font-letter-spacing);
    text-transform: var(--summary-font-case);
    text-wrap: var(--summary-font-wrap);
    color: var(--summary-color);
    padding-top: var(--summary-padding-top);
    padding-bottom: var(--summary-padding-bottom);
    padding-left: var(--summary-padding-left);
    padding-right: var(--summary-padding-right);
    min-height: var(--minimum-touch-target);
  }

  /* Mobile typography override */
  @media screen and (max-width: 749px) {
    .product-accordion.accordion .details__header {
      font-size: var(--summary-font-size-mobile, var(--summary-font-size));
    }
  }

  .product-accordion.accordion .details__header .icon,
  .product-accordion.accordion .details__header svg {
    color: var(--icon-color, currentColor);
    fill: var(--icon-color, currentColor);
  }

  .product-accordion .details {
    cursor: pointer;
  }

  .product-accordion .details__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .product-accordion .details__header::-webkit-details-marker {
    display: none;
  }

  .product-accordion .details__header-text {
    flex: 1;
  }

  .product-accordion .details .icon {
    display: flex;
    align-items: center;
    margin-left: 1rem;
    transition: transform 0.2s ease;
  }

  .product-accordion .details[open] .icon-caret {
    transform: rotate(180deg);
  }

  .product-accordion .details[open] .icon-plus {
    transform: rotate(0deg);
  }

  .product-accordion .details-content {
    padding-top: 0.5rem;
    padding-bottom: 1rem;
  }

  .product-accordion .details-content.rte {
    font-size: 1rem;
  }

  .product-accordion .placeholder-message {
    background: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
  }

  .product-accordion .placeholder-message code {
    background: rgba(0, 0, 0, 0.1);
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    font-size: 0.75rem;
  }
{% endstylesheet %}

