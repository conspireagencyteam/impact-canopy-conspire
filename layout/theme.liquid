<!-- Facebook Campaign Attribution Tracking -->
<script>
(function () {
  'use strict';

  var FIRST_KEY = 'impact_fb_first_campaign';
  var LATEST_KEY = 'impact_fb_latest_campaign';
  var MAX_AGE = 30 * 24 * 60 * 60 * 1000;
  var syncing = false;
  var lastSync = 0;

  function storageAllowed() {
    return !!(
      window.Shopify &&
      Shopify.customerPrivacy &&
      Shopify.customerPrivacy.marketingAllowed()
    );
  }

  function readCampaign(key) {
    try {
      var raw = localStorage.getItem(key);
      if (!raw) return null;

      var data = JSON.parse(raw);
      var age = Date.now() - Date.parse(data.captured_at);

      if (!Number.isFinite(age) || age < 0 || age > MAX_AGE) {
        localStorage.removeItem(key);
        return null;
      }

      return data;
    } catch (e) {
      return null;
    }
  }

  function captureCampaign() {
    var params = new URLSearchParams(location.search);
    var source = (params.get('utm_source') || '').toLowerCase();
    var fbclid = params.get('fbclid');

    var isFacebook =
      ['facebook', 'fb', 'instagram', 'ig', 'meta'].includes(source) ||
      !!fbclid;

    if (!isFacebook) return;

    var campaign = {
      campaign: params.get('utm_campaign') || 'Facebook - Unknown Campaign',
      campaign_id: params.get('utm_id') || '',
      source: source || 'facebook',
      medium: params.get('utm_medium') || '',
      captured_at: new Date().toISOString()
    };

    try {
      if (!readCampaign(FIRST_KEY)) {
        localStorage.setItem(FIRST_KEY, JSON.stringify(campaign));
      }

      localStorage.setItem(LATEST_KEY, JSON.stringify(campaign));
    } catch (e) {
      console.warn('Facebook campaign storage unavailable', e);
    }
  }

  async function syncCart(force) {
    if (!storageAllowed() || syncing) return;

    if (!force && Date.now() - lastSync < 3000) return;

    syncing = true;

    try {
      var campaign = readCampaign(LATEST_KEY);

      if (!campaign) return;

      var root = (window.Shopify.routes &&
        window.Shopify.routes.root) || '/';

      var response = await fetch(root + 'cart.js', {
        credentials: 'same-origin'
      });

      if (!response.ok) throw new Error('Cart read failed');

      var cart = await response.json();
      var existing = cart.attributes || {};

      var desired = {
        'Facebook Campaign': campaign.campaign,
        'Facebook Campaign ID': campaign.campaign_id,
        'Facebook Campaign Date': campaign.captured_at
      };

      if (
        existing['Facebook Campaign'] === desired['Facebook Campaign'] &&
        (existing['Facebook Campaign ID'] || '') === desired['Facebook Campaign ID'] &&
        existing['Facebook Campaign Date'] === desired['Facebook Campaign Date']
      ) {
        return;
      }

      var update = await fetch(root + 'cart/update.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attributes: desired })
      });

      if (!update.ok) throw new Error('Cart update failed');

      lastSync = Date.now();
    } catch (e) {
      console.warn('Facebook attribution sync error:', e);
    } finally {
      syncing = false;
    }
  }

  function clearTracking() {
    try {
      localStorage.removeItem(FIRST_KEY);
      localStorage.removeItem(LATEST_KEY);
    } catch (e) {}

    var root = (window.Shopify && Shopify.routes &&
      Shopify.routes.root) || '/';

    fetch(root + 'cart/update.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        attributes: {
          'Facebook Campaign': '',
          'Facebook Campaign ID': '',
          'Facebook Campaign Date': ''
        }
      })
    }).catch(function () {});
  }

  function run() {
    if (!storageAllowed()) {
      clearTracking();
      return;
    }

    captureCampaign();
    syncCart(true);
  }

  function initialize() {
    if (!window.Shopify || !Shopify.loadFeatures) return;

    Shopify.loadFeatures(
      [{ name: 'consent-tracking-api', version: '0.1' }],
      function (error) {
        if (error || !Shopify.customerPrivacy) return;

        run();
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }

  document.addEventListener('visitorConsentCollected', run);

  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!target || !target.closest) return;

    var button = target.closest(
      'button[name="add"], form[action*="/cart/add"] button'
    );

    if (button) {
      setTimeout(function () { syncCart(true); }, 1200);
    }
  });

  document.addEventListener('submit', function (event) {
    var form = event.target;
    if (form && form.matches &&
        form.matches('form[action*="/cart/add"]')) {
      setTimeout(function () { syncCart(true); }, 1200);
    }
  });

  window.addEventListener('pageshow', function () {
    initialize();
  });

  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) syncCart(false);
  });
})();
</script>
<!-- End Facebook Campaign Attribution Tracking -->

{% if customer and customer.email != blank %}
<script>
(function () {
  if (!window.Shopify || !Shopify.loadFeatures) return;

  Shopify.loadFeatures(
    [{ name: 'consent-tracking-api', version: '0.1' }],
    function(error) {
      if (error || !Shopify.customerPrivacy) return;

      // Only identify visitors when analytics tracking is allowed.
      if (!Shopify.customerPrivacy.analyticsProcessingAllowed()) return;

      window._hsq = window._hsq || [];

      window._hsq.push([
        'identify',
        {
          email: {{ customer.email | json }}
        }
      ]);

      window._hsq.push(['trackPageView']);

      console.log('HubSpot customer identification sent');
    }
  );
})();
</script>
{% endif %}
