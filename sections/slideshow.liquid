          },
          "block_order": ["group"]
        },
        "slide_2": {
          "type": "_slide",
          "settings": {
            "horizontal_alignment_flex_direction_column": "center"
          },
          "blocks": {
            "group": {
              "type": "group",
              "settings": {
                "horizontal_alignment_flex_direction_column": "center",
                "width": "custom",
                "custom_width": 50,
                "width_mobile": "custom",
                "inherit_color_scheme": false,
