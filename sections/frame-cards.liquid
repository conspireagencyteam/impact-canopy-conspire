{% comment %}
  Frame Cards Section
  A grid of frame product cards with progress bar ratings
{% endcomment %}

<style>
  .frame-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--frame-cards-columns, 2), 1fr);
    gap: var(--frame-cards-gap, 24px);
  }

  @media screen and (max-width: 749px) {
    .frame-cards__grid {
      grid-template-columns: repeat(var(--frame-cards-columns-mobile, 1), 1fr);
    }
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    frame-cards
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings, mobile: section.settings.use_mobile_padding %}
    {% render 'gap-style', value: section.settings.gap %}
    --frame-cards-columns: {{ section.settings.columns }};
    --frame-cards-columns-mobile: {{ section.settings.columns_mobile }};
    --frame-cards-gap: {{ section.settings.cards_gap }}px;
  "
>
  {%  content_for 'block', id: 'staticHeader', type: 'text' %}

  <div class="frame-cards__grid">
    {% assign table_rows = metaobjects.frames.values %}
    {% for row in table_rows %}
      {% content_for 'block', type: '_frame-card', id: 'staticFrameCard', item: row %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Frame Cards",
  "class": "frame-cards-section",
  "tag": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (Desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "cards_gap",
      "label": "Gap Between Cards",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_padding",
      "label": "Use Mobile Padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.use_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.use_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start-mobile",
      "label": "Left (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.use_mobile_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end-mobile",
      "label": "Right (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.use_mobile_padding == true }}"
    }
  ],
  "presets": [
    {
      "name": "Frame Cards",
      "category": "Custom",
      "settings": {
        "section_width": "page-width",
        "columns": 2,
        "columns_mobile": "1",
        "cards_gap": 24,
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    }
  ]
}
{% endschema %}
