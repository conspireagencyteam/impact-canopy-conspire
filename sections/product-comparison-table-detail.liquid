            {% if section.settings.col_name_10 != blank %}
            <th class="product-comparison-table__th">{{ section.settings.col_name_10 }}</th>
            {% endif %}
            {% if section.settings.col_name_11 != blank %}
            <th class="product-comparison-table__th">{{ section.settings.col_name_11 }}</th>
            {% endif %}
            {% if section.settings.col_name_12 != blank %}
            <th class="product-comparison-table__th">{{ section.settings.col_name_12 }}</th>
            {% endif %}
          {% endfor %}
        </tr>
      </thead>
      <tbody class="product-comparison-table__tbody">
        {% assign table_rows = metaobjects.frames.values %}
        {% for row in table_rows %}
          {% assign col_one = row.logo %}
          {% assign col_two = row.material %}
          {% assign col_three = row.structure_color %}
          {% assign col_four = row.latch %}
          {% assign col_five = row.best_for %}
          {% assign col_six = row.parts_available %}
          {% assign col_seven = row.col_seven %}
          {% assign col_eight = row.col_eight %}
          {% assign col_nine = row.col_nine %}
