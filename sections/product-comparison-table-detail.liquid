        <col class="product-comparison-table__col-10">
        <col class="product-comparison-table__col-11">
        <col class="product-comparison-table__col-12">
      </colgroup>
      <thead class="product-comparison-table__thead">
        <tr>
          {% assign table_rows = metaobjects.frames.values %}
          {% for row in table_rows %}
            {% if section.settings.col_name_1 != blank %}
            <th class="product-comparison-table__th product-comparison-table__logo-cell">{{ section.settings.col_name_1 }}</th>
            {% endif %}
            {% if section.settings.col_name_2 != blank %}
            <th class="product-comparison-table__th">{{ section.settings.col_name_2 }}</th>
            {% endif %}
            {% if section.settings.col_name_3 != blank %}
            <th class="product-comparison-table__th">{{ section.settings.col_name_3 }}</th>
            {% endif %}
            {% if section.settings.col_name_4 != blank %}
            <th class="product-comparison-table__th">{{ section.settings.col_name_4 }}</th>
            {% endif %}
            {% if section.settings.col_name_5 != blank %}
            <th class="product-comparison-table__th">{{ section.settings.col_name_5 }}</th>
            {% endif %}
            {% if section.settings.col_name_6 != blank %}
            <th class="product-comparison-table__th">{{ section.settings.col_name_6 }}</th>
            {% endif %}
            {% if section.settings.col_name_7 != blank %}
            <th class="product-comparison-table__th">{{ section.settings.col_name_7 }}</th>
            {% endif %}
            {% if section.settings.col_name_8 != blank %}
            <th class="product-comparison-table__th">{{ section.settings.col_name_8 }}</th>
            {% endif %}
            {% if section.settings.col_name_9 != blank %}
            <th class="product-comparison-table__th">{{ section.settings.col_name_9 }}</th>
