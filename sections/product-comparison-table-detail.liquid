<script>
  (function() {
    const script = document.currentScript;
    const section = script.closest('.product-comparison-table') || script.parentElement.querySelector('.product-comparison-table');

    function init() {
      const container = section || document.querySelector('.product-comparison-table');
      if (!container) return;

      const wrapper = container.querySelector('.product-comparison-table__wrapper');
      const scrollbarContainer = container.querySelector('.product-comparison-table__scrollbar-container');
      const track = container.querySelector('.product-comparison-table__scrollbar-track');
      const thumb = container.querySelector('.product-comparison-table__scrollbar-thumb');

      if (!wrapper || !track || !thumb || !scrollbarContainer) return;

      let isDragging = false;
      let startX = 0;
      let startScrollLeft = 0;

      function updateScrollbar() {
        const scrollWidth = wrapper.scrollWidth;
        const clientWidth = wrapper.clientWidth;
        const isOverflowing = scrollWidth > clientWidth;

        if (isOverflowing) {
          scrollbarContainer.classList.add('is-visible');
          const thumbWidthPercent = Math.max((clientWidth / scrollWidth) * 100, 10);
          thumb.style.width = thumbWidthPercent + '%';
          updateThumbPosition();
        } else {
          scrollbarContainer.classList.remove('is-visible');
        }
      }

      function updateThumbPosition() {
        const scrollWidth = wrapper.scrollWidth;
        const clientWidth = wrapper.clientWidth;
        const scrollLeft = wrapper.scrollLeft;
        const maxScroll = scrollWidth - clientWidth;
        const trackWidth = track.offsetWidth;
        const thumbWidth = thumb.offsetWidth;
        const maxThumbLeft = trackWidth - thumbWidth;

        if (maxScroll > 0 && maxThumbLeft > 0) {
          const thumbLeft = (scrollLeft / maxScroll) * maxThumbLeft;
          thumb.style.left = thumbLeft + 'px';
        }
      }

      function checkOverflow() {
        const isOverflowing = wrapper.scrollWidth > wrapper.clientWidth;
        const isScrolled = wrapper.scrollLeft > 0;

        if (isOverflowing && isScrolled) {
          wrapper.classList.add('is-scrolled');
        } else {
          wrapper.classList.remove('is-scrolled');
        }
      }

      // Sync wrapper scroll with thumb position
      wrapper.addEventListener('scroll', function() {
        checkOverflow();
        if (!isDragging) {
          updateThumbPosition();
        }
      });

      // Thumb drag functionality
      let startThumbLeft = 0;

      thumb.addEventListener('mousedown', function(e) {
        isDragging = true;
        startX = e.clientX;
        startScrollLeft = wrapper.scrollLeft;
        startThumbLeft = thumb.offsetLeft;
        thumb.style.cursor = 'grabbing';
        document.body.style.userSelect = 'none';
        document.body.style.cursor = 'grabbing';
        e.preventDefault();
        e.stopPropagation();
      });

      document.addEventListener('mousemove', function(e) {
        if (!isDragging) return;

        const deltaX = e.clientX - startX;
        const trackWidth = track.offsetWidth;
        const thumbWidth = thumb.offsetWidth;
        const maxThumbLeft = trackWidth - thumbWidth;
        const scrollWidth = wrapper.scrollWidth;
        const clientWidth = wrapper.clientWidth;
        const maxScroll = scrollWidth - clientWidth;

        if (maxThumbLeft > 0) {
          // Calculate new thumb position
          let newThumbLeft = startThumbLeft + deltaX;
          newThumbLeft = Math.max(0, Math.min(newThumbLeft, maxThumbLeft));

          // Set thumb position directly
          thumb.style.left = newThumbLeft + 'px';

          // Calculate and set scroll position
          const scrollLeft = (newThumbLeft / maxThumbLeft) * maxScroll;
          wrapper.scrollLeft = scrollLeft;
        }
      });

      document.addEventListener('mouseup', function() {
        if (isDragging) {
          isDragging = false;
          thumb.style.cursor = 'grab';
          document.body.style.userSelect = '';
          document.body.style.cursor = '';
        }
      });

      // Track click functionality
      track.addEventListener('click', function(e) {
        if (e.target === thumb) return;

        const trackRect = track.getBoundingClientRect();
        const clickX = e.clientX - trackRect.left;
        const trackWidth = track.offsetWidth;
        const thumbWidth = thumb.offsetWidth;
        const scrollWidth = wrapper.scrollWidth;
        const clientWidth = wrapper.clientWidth;
        const maxScroll = scrollWidth - clientWidth;
        const maxThumbLeft = trackWidth - thumbWidth;

        if (maxThumbLeft > 0) {
          const targetThumbLeft = clickX - (thumbWidth / 2);
          const clampedThumbLeft = Math.max(0, Math.min(targetThumbLeft, maxThumbLeft));
          const scrollLeft = (clampedThumbLeft / maxThumbLeft) * maxScroll;
          wrapper.scrollTo({ left: scrollLeft, behavior: 'smooth' });
        }
      });

      // Touch support for thumb drag
      thumb.addEventListener('touchstart', function(e) {
        isDragging = true;
        startX = e.touches[0].clientX;
        startScrollLeft = wrapper.scrollLeft;
        startThumbLeft = thumb.offsetLeft;
        e.preventDefault();
      }, { passive: false });

      document.addEventListener('touchmove', function(e) {
        if (!isDragging) return;

        const deltaX = e.touches[0].clientX - startX;
        const trackWidth = track.offsetWidth;
        const thumbWidth = thumb.offsetWidth;
        const maxThumbLeft = trackWidth - thumbWidth;
        const scrollWidth = wrapper.scrollWidth;
        const clientWidth = wrapper.clientWidth;
        const maxScroll = scrollWidth - clientWidth;

        if (maxThumbLeft > 0) {
          // Calculate new thumb position
          let newThumbLeft = startThumbLeft + deltaX;
          newThumbLeft = Math.max(0, Math.min(newThumbLeft, maxThumbLeft));

          // Set thumb position directly
          thumb.style.left = newThumbLeft + 'px';

          // Calculate and set scroll position
          const scrollLeft = (newThumbLeft / maxThumbLeft) * maxScroll;
          wrapper.scrollLeft = scrollLeft;
        }
      }, { passive: true });

      document.addEventListener('touchend', function() {
        isDragging = false;
      });

      window.addEventListener('resize', function() {
        updateScrollbar();
        checkOverflow();
      });

      // Initial setup
      updateScrollbar();
      checkOverflow();
    }

    // Run init when DOM is ready or immediately if already loaded
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

