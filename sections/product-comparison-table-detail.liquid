<style>
  .product-comparison-table {
    --table-header-bg: #f5f5f5;
    --table-border-color: #cccccc;
    --table-text-color: #5c2d82;
    --table-accent-color: #5c2d82;
    --table-accent-secondary: #f47920;
    --table-row-bg: #fff;
    --table-row-alt-bg: #fff;
    --table-best-for-bg: #EEF0F2;
    --table-best-for-border: #fff;

    /* Desktop column widths (percentage) */
    --col-1-width-desktop: 6.7%;
    --col-2-width-desktop: 10%;
    --col-3-width-desktop: 10%;
    --col-4-width-desktop: 10%;
    --col-5-width-desktop: 10.3%;
    --col-6-width-desktop: 8.3%;
    --col-7-width-desktop: 5.5%;
    --col-8-width-desktop: 7.8%;
    --col-9-width-desktop: 6.2%;
    --col-10-width-desktop: 8.5%;
    --col-11-width-desktop: 8.5%;
    --col-12-width-desktop: 8.2%;

    /* Mobile column widths (pixels) */
    --col-1-width-mobile: 90px;
    --col-2-width-mobile: 120px;
    --col-3-width-mobile: 120px;
    --col-4-width-mobile: 120px;
    --col-5-width-mobile: 120px;
    --col-6-width-mobile: 150px;
    --col-7-width-mobile: 150px;
    --col-8-width-mobile: 150px;
    --col-9-width-mobile: 150px;
    --col-10-width-mobile: 150px;
    --col-11-width-mobile: 150px;
    --col-12-width-mobile: 150px;
  }

  .product-comparison-table__wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 16px;
    border: 1px solid var(--table-border-color);
    background-color: #ffffff;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
  }

  .product-comparison-table__wrapper::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }

  /* Custom scrollbar container */
  .product-comparison-table__scrollbar-container {
    width: 100%;
    margin-top: 6px;
    display: none;
  }

  .product-comparison-table__scrollbar-container.is-visible {
    display: block;
    padding: 2px;
    border-radius: 100px;
    background: #ccc;
  }

  .product-comparison-table__scrollbar-track {
    width: 100%;
    height: 8px;
    background: #CCC;
    border-radius: 4px;
    position: relative;
    cursor: pointer;
  }

  .product-comparison-table__scrollbar-thumb {
    height: 100%;
    background: #fff;
    border-radius: 4px;
    position: absolute;
    top: 0;
    left: 0;
    cursor: grab;
    min-width: 40px;
    transition: background 0.2s ease, left 0s;
  }

  .product-comparison-table__scrollbar-thumb:hover {
    background: var(--table-accent-secondary, #f47920);
  }

  .product-comparison-table__scrollbar-thumb:active {
    cursor: grabbing;
  }

  .product-comparison-table__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    min-width: 700px;
    table-layout: fixed;
  }

  /* Desktop column widths */
  @media screen and (min-width: 750px) {
    .product-comparison-table__table {
      table-layout: fixed;
    }

    .product-comparison-table__col-1 { width: var(--col-1-width-desktop); min-width: var(--col-1-width-mobile); }
    .product-comparison-table__col-2 { width: var(--col-2-width-desktop); min-width: var(--col-2-width-mobile); }
    .product-comparison-table__col-3 { width: var(--col-3-width-desktop); min-width: var(--col-3-width-mobile); }
    .product-comparison-table__col-4 { width: var(--col-4-width-desktop); min-width: var(--col-4-width-mobile); }
    .product-comparison-table__col-5 { width: var(--col-5-width-desktop); min-width: var(--col-5-width-mobile); }
    .product-comparison-table__col-6 { width: var(--col-6-width-desktop); min-width: var(--col-6-width-mobile); }
    .product-comparison-table__col-7 { width: var(--col-7-width-desktop); min-width: var(--col-7-width-mobile); }
    .product-comparison-table__col-8 { width: var(--col-8-width-desktop); min-width: var(--col-8-width-mobile); }
    .product-comparison-table__col-9 { width: var(--col-9-width-desktop); min-width: var(--col-9-width-mobile); }
    .product-comparison-table__col-10 { width: var(--col-10-width-desktop); min-width: var(--col-10-width-mobile); }
    .product-comparison-table__col-11 { width: var(--col-11-width-desktop); min-width: var(--col-11-width-mobile); }
    .product-comparison-table__col-12 { width: var(--col-12-width-desktop); min-width: var(--col-12-width-mobile); }
  }

  /* Mobile column widths */
  @media screen and (max-width: 749px) {
    .product-comparison-table__col-1 { width: var(--col-1-width-mobile); min-width: var(--col-1-width-mobile); }
    .product-comparison-table__col-2 { width: var(--col-2-width-mobile); min-width: var(--col-2-width-mobile); }
    .product-comparison-table__col-3 { width: var(--col-3-width-mobile); min-width: var(--col-3-width-mobile); }
    .product-comparison-table__col-4 { width: var(--col-4-width-mobile); min-width: var(--col-4-width-mobile); }
    .product-comparison-table__col-5 { width: var(--col-5-width-mobile); min-width: var(--col-5-width-mobile); }
    .product-comparison-table__col-6 { width: var(--col-6-width-mobile); min-width: var(--col-6-width-mobile); }
    .product-comparison-table__col-7 { width: var(--col-7-width-mobile); min-width: var(--col-7-width-mobile); }
    .product-comparison-table__col-8 { width: var(--col-8-width-mobile); min-width: var(--col-8-width-mobile); }
    .product-comparison-table__col-9 { width: var(--col-9-width-mobile); min-width: var(--col-9-width-mobile); }
    .product-comparison-table__col-10 { width: var(--col-10-width-mobile); min-width: var(--col-10-width-mobile); }
    .product-comparison-table__col-11 { width: var(--col-11-width-mobile); min-width: var(--col-11-width-mobile); }
    .product-comparison-table__col-12 { width: var(--col-12-width-mobile); min-width: var(--col-12-width-mobile); }
  }

  .product-comparison-table__thead {
    background: var(--table-header-bg);
  }

  .product-comparison-table__th {
    padding: 12px;
    text-align: center;
    font-weight: 600;
    font-size: 14px;
    color: var(--table-accent-color);
    white-space: wrap;
    background: var(--table-row-bg);
    border-bottom: 1px solid #ccc;
    border-right: 1px solid #ccc;
  }

  .product-comparison-table__th:last-child {
    border-right: none;
  }

  /* First row top-left corner radius */
  .product-comparison-table__thead .product-comparison-table__th:first-child {
    border-top-left-radius: 15px;
  }

  /* First row top-right corner radius */
  .product-comparison-table__thead .product-comparison-table__th:last-child {
    border-top-right-radius: 15px;
  }

  /* Best For column header */
  .product-comparison-table__th.product-comparison-table__th--best-for {
    background: var(--table-best-for-bg);
    border-top: 1px solid var(--table-best-for-border);
    border-bottom: 1px solid var(--table-best-for-border);
  }

  /* Default: no sticky */
  .product-comparison-table__th:first-child,
  .product-comparison-table__td:first-child {
    background: var(--table-row-bg);
  }

  .product-comparison-table__thead .product-comparison-table__th:first-child {
    background: var(--table-row-bg);
  }

  /* Sticky Column Layout - applies to both mobile and desktop when enabled */
  .product-comparison-table--sticky .product-comparison-table__th:first-child,
  .product-comparison-table--sticky .product-comparison-table__td:first-child {
    position: sticky;
    left: 0;
    z-index: 2;
    background: var(--table-row-bg);
  }

  .product-comparison-table--sticky .product-comparison-table__thead .product-comparison-table__th:first-child {
    z-index: 3;
  }

  .product-comparison-table__th:first-child {
    text-align: center;
  }

  .product-comparison-table__tbody tr {
    transition: background-color 0.2s ease;
  }

  .product-comparison-table__tbody tr:hover {
    background-color: var(--table-row-alt-bg);
  }

  .product-comparison-table__tbody tr:hover .product-comparison-table__td:first-child {
    background-color: var(--table-row-alt-bg);
  }

  .product-comparison-table__td {
    padding: 10px;
    text-align: center;
    vertical-align: middle;
    font-size: 13px;
    font-weight: 500;
    color: var(--table-text-color);
    background: var(--table-row-bg);
    border-bottom: none;
    border-right: 1px solid #ccc;
  }

  .product-comparison-table__td.product-comparison-table__td__inner-table {
    padding: 0 !important;
  }

  .product-comparison-table__td.product-comparison-table__td__inner-table table,
  .product-comparison-table__td.product-comparison-table__td__inner-table table tbody,
  .product-comparison-table__td.product-comparison-table__td__inner-table table tbody tr {
    display: flex;
    flex-direction: column;
  }
  .product-comparison-table__td.product-comparison-table__td__inner-table table tbody tr td {
    border-bottom: 1px solid #ccc;
    padding: 12px;
  }

  .product-comparison-table__td.product-comparison-table__td__inner-table table tbody tr:last-child td {
    border-bottom: none;
  }

  .product-comparison-table__td.product-comparison-table__td__inner-table td {
    position: static !important;
    z-index: 1 !important;
  }


  .product-comparison-table__td:last-child {
    border-right: none;
  }

  /* Last row bottom-left corner radius */
  .product-comparison-table__tbody tr:last-child .product-comparison-table__td:first-child {
    border-bottom-left-radius: 0;
  }

  /* Last row bottom-right corner radius */
  .product-comparison-table__tbody tr:last-child .product-comparison-table__td:last-child {
    border-bottom-right-radius: 0;
  }

  .product-comparison-table__td:first-child {
    text-align: center;
  }

  /* Show box shadow only when table is scrolled and sticky is enabled */
  .product-comparison-table--sticky .product-comparison-table__wrapper.is-scrolled .product-comparison-table__th:first-child,
  .product-comparison-table--sticky .product-comparison-table__wrapper.is-scrolled .product-comparison-table__td:first-child {
    box-shadow: 2px 0 5px -2px rgba(0, 0, 0, 0.1);
  }

  .product-comparison-table__logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }

  .product-comparison-table__logo-cell {
    img {
      width: 95px;
      height: 90px;
      object-fit: contain;
      mix-blend-mode: multiply;
    }
  }

  .product-comparison-table__material {
    font-weight: 500;
  }

  .product-comparison-table__structure-color {
    color: var(--table-accent-color);
    font-weight: 500;
  }

  .product-comparison-table__latch {
    color: var(--table-accent-color);
    font-weight: 500;
  }

  .product-comparison-table__best-for {
    color: var(--table-accent-color);
    font-weight: 500;
    line-height: 1.5;
    background: var(--table-best-for-bg);
    border-top: 1px solid var(--table-best-for-border);
    border-bottom: 1px solid var(--table-best-for-border);
  }

  .product-comparison-table__availability {
    font-weight: 500;
  }

  .product-comparison-table__availability--special {
    color: var(--table-accent-color);
  }

  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .product-comparison-table__table {
      min-width: 700px;
    }

    .product-comparison-table__th,
    .product-comparison-table__td {
      padding: 12px;
      font-size: 12px;
    }

    .product-comparison-table__logo {
      width: 50px;
      height: 50px;
    }

    .product-comparison-table__best-for {
      max-width: none;
    }
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    product-comparison-table
    {% if section.settings.sticky_column %}product-comparison-table--sticky{% endif %}
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings, mobile: section.settings.use_mobile_padding %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {%  content_for 'block', id: 'staticHeader', type: 'text' %}

