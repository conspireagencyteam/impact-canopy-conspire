843/t/3/assets/pf-575bac80--honda.png?v=1586297224" alt="Honda partner logo" title="Honda partner logo"></picture></div></div></div></div></div><div data-container="true" class="sc-pZopv bjKdkd pf-10ed51fb" id="product-overview" data-pf-type="Section"><div class="sc-pQQXS iWCqut" style="max-width: 1170px;"><div class="sc-qPjXN eYzxUD pf-6789cc10 pf-r pf-r-eh" data-pf-type="Row" style="--pf-s-lg:15px; --pf-s-md:15px; --pf-s-sm:15px; --pf-s-xs:15px;"><div class="sc-pbYdQ jklmHY pf-c pf-c-xs--12 pf-c-sm--12 pf-c-md--12 pf-c-lg--12"><div class="sc-pkUyL fTyjzF pf-776789cc" data-pf-type="Column"><div data-pf-scrolltop="false" data-multiple="false" data-pf-type="Accordion2" class="sc-pkfPC GftoS pf-821797d7"><div class="sc-pJipy mZVAk pf-256b2011 accordion__item" data-pf-type="Accordion2.Content.Wrapper"><button type="button" class="sc-pBlxj gYSgcm pf-7255ea2c pf-bg-lazy accordion__header pf-anchor" data-header-id="55ea2c76-7f02-4e2c-8b62-88ea22751e27" data-action="accordion2" data-preopen="false" data-active="false" data-pf-type="Accordion.Header"><i class="icon_position accordion__arrow fa fa-chevron-right"></i>Product Overview</button><div class="sc-qYUWV exYsxy pf-28256b20 accordion__content" mode="view" data-id="55ea2c76-7f02-4e2c-8b62-88ea22751e27" data-pf-type="Accordion2.Content" style="display: none;"><div data-pf-type="Divider" class="sc-qQKeD NKnmf pf-7f025e2c"><div><span data-pf-type="Text" class="sc-ptSuy fnmilh pf-2c767f02">Product Overview</span></div></div><p data-pf-type="Paragraph2" class="sc-pkvvt cbrLgP pf-dc8e12c8"><span data-pf-type="Text" class="sc-ptSuy fnmilh pf-d528256b">Take advantage of every surface to get your message to your customer by incorporating an Impact Table Cover. Available in 4 styles (Fitted, Stretch, Tapered, and Table Throw) and standard or custom sizes. Our table covers are custom printed to your specifications and will add the finishing touch to your display.<br></span></p><h3 data-pf-type="Heading" class="sc-oTLFK lcHmGL pf-22751e27"><span data-pf-type="Text" class="sc-ptSuy fnmilh pf-ffa21dd5">FITTED TABLE COVER</span></h3><img sizes="(min-width: 992px) 1200px, (min-width: 768px) and (max-width: 991px) 800px, 400px" data-srcset="https://cdn.shopify.com/s/files/1/0260/9522/2843/t/3/assets/pf-001afd8c--itemTableCovers1150x150-Edited.jpg?v=1586317743 1200w, https://cdn.shopify.com/s/files/1/0260/9522/2843/t/3/assets/pf-001afd8c--itemTableCovers1150x150-Edited.jpg?v=1586317743 800w, https://cdn.shopify.com/s/files/1/0260/9522/2843/t/3/assets/pf-001afd8c--itemTableCovers1150x150-Edited.jpg?v=1586317743 400w" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="stretch table cover" title="stretch table cover" class="sc-qZtVr dLIPjF pf-a21dd528 pf-img-lazy" data-pf-type="Image2"><p data-pf-type="Paragraph2" class="sc-pkvvt cbrLgP pf-5d61ad00"><span data-pf-type="Text" class="sc-ptSuy fnmilh pf-b6b85d61">Impact Canopy’s fitted table cover is perfect for a clean and professional look. Our collection of fitted table covers offers a snug fit for standard sized rectangle tables. Full digital printing gives you the ability to completely design your fitted tablecloth, or you can keep it simple with inventoried fabric and your logo on the front panel. This versatile table cover offers a variety of customizations to fit any need.<br><br>Great for corporate events, trade show displays, promotional events, and more.<br></span></p><h3 data-pf-type="Heading" class="sc-oTLFK lcHmGL pf-49b6001a"><span data-pf-type="Text" class="sc-ptSuy fnmilh pf-2a2a49b6">STRETCH TABLE COVER<br></span></h3><img sizes="(min-width: 992px) 1200px, (min-width: 768px) and (max-width: 991px) 800px, 400px" data-srcset="https://cdn.shopify.com/s/files/1/0260/9522/2843/t/3/assets/pf-f860cc19--itemTableCoverStretch1150x150-Edited.jpg?v=1586317586 1200w, https://cdn.shopify.com/s/files/1/0260/9522/2843/t/3/assets/pf-f860cc19--itemTableCoverStretch1150x150-Edited.jpg?v=1586317586 800w, https://cdn.shopify.com/s/files/1/0260/9522/2843/t/3/assets/pf-f860cc19--itemTableCoverStretch1150x150-Edited.jpg?v=1586317586 400w" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="stretch table cover" title="stretch table cover" class="sc-qZtVr dLIPjF pf-fc967eb8 pf-img-lazy" data-pf-type="Image2"><p data-pf-type="Paragraph2" class="sc-pkvvt cbrLgP pf-1b2cd416"><span data-pf-type="Text" class="sc-ptSuy fnmilh pf-eaaf1b2c">Looking for something a little more unique? Impact Canopy’s Stretch Table Cover combines modern sophistication and urban elegance that is sure to impress. Our Stretch Table Covers are durable and do not require ironing, making these long lasting and easy to set up. Plus, with a full digital print, keep your company image at the forefront of your display with a bold design.<br><br>Great for conventions, expos, hotels, weddings, and more.<br></span></p><h3 data-pf-type="Heading" class="sc-oTLFK lcHmGL pf-75af781a"><span data-pf-type="Text" class="sc-ptSuy fnmilh pf-b63375af">THROW TABLE COVER<br></span></h3><img sizes="(min-width: 992px) 1200px, (min-width: 768px) and (max-width: 991px) 800px, 400px" data-srcset="https://cdn.shopify.com/s/files/1/0260/9522/2843/t/3/assets/pf-b6001afd--itemTableCoverThrow1150x150-Edited.jpg?v=1586317651 1200w, https://cdn.shopify.com/s/files/1/0260/9522/2843/t/3/assets/pf-b6001afd--itemTableCoverThrow1150x150-Edited.jpg?v=1586317651 800w, https://cdn.shopify.com/s/files/1/0260/9522/2843/t/3/assets/pf-b6001afd--itemTableCoverThrow1150x150-Edited.jpg?v=1586317651 400w" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="stretch table cover" title="stretch table cover" class="sc-qZtVr dLIPjF pf-d416fc96 pf-img-lazy" data-pf-type="Image2"><p data-pf-type="Paragraph2" class="sc-pkvvt cbrLgP pf-4615a1e5"><span data-pf-type="Text" class="sc-ptSuy fnmilh pf-d4174615">Turn a simple table into branded marketing in seconds using an Impact Throw Table Cover. This table cover draws the attention to your logo while also creating a perfect storage area for any marketing materials or boxes you may wish to keep out of sight.<br><br>Great for event check-in stations, job fairs, information stations, and more.<br></span></p></div></div><div class="sc-pJipy mZVAk pf-cd95a87d accordion__item" data-pf-type="Accordion2.Content.Wrapper"><button type="button" class="sc-pBlxj gYSgcm pf-57a16b9c pf-bg-lazy accordion__header pf-anchor" data-header-id="a16b9c5a-08f7-4675-978c-db86f613cec1" data-action="accordion2" data-preopen="false" data-active="false" data-pf-type="Accordion.Header"><i class="icon_position accordion__arrow fa fa-chevron-right"></i>Product Specs</button><div class="sc-qYUWV exYsxy pf-6acd95a8 accordion__content" mode="view" data-id="a16b9c5a-08f7-4675-978c-db86f613cec1" data-pf-type="Accordion2.Content" style="display: none;"><div data-pf-type="Divider" class="sc-qQKeD NKnmf pf-08f7a675"><div><span data-pf-type="Text" class="sc-ptSuy fnmilh pf-9c5a08f7">Product Specs</span></div></div><p data-pf-type="Paragraph2" class="sc-pkvvt cbrLgP pf-d978dab1"><span data-pf-type="Text" class="sc-ptSuy fnmilh pf-866acd95"><span style="font-weight: bold;">Silk Screen Printing:<br></span>The traditional way to have your logo applied to fabric products has been through a Silk Screen Print Application. This process involves an initial screen set up, however the application of the ink has a minimal cost and is ideal for larger volume orders. Silk Screen Print application is durable, vibrant and can make your image POP!<br><br><span style="font-weight: 700;">Digital Printing:<br></span>We use “Cutting Edge” Dye sublimation printing technology to achieve full bleed graphics on your fabric products. This digital process dyes the fabric and allows for unlimited graphic possibilities for image and logo reproductions. If you desire to be the best and have the best, the Impact Instant Canopy Digital Print Process is the answer.<br><br></span></p><d