{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.

  @example
  {% render 'search', style: 'default', class: 'custom-class' %}
{%- enddoc -%}

{% if style == 'block' %}
  <div class="mobile:hidden desktop-search-main">
  {% render 'predictive-search-desktop-header',
    input_id: 'cmdk-input',
    search_test_id: 'search-component--desktop-header',
    products_test_id: 'products-list-default--modal'
  %}
  </div>
{% else %}

{% unless style == 'none' %}
  <search-button class="search-action{% if class != blank %} {{ class | strip }}{% endif %}">
    <button
      on:click="#search-modal/showDialog"
      class="button button-unstyled search-modal__button header-actions__action"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span aria-hidden="true" class="svg-wrapper">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
  </search-button>
{% endunless %}
{% endif %}

{% stylesheet %}
  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
  }

  .desktop-search-main {
    width: calc(100% - 1rem);
  }

  .desktop-search-main .predictive-search-form__header {
    border-radius: 6px;
    overflow: hidden;
    height: 44px;
  }

  .desktop-search-main .predictive-search-form__header .predictive-search-form__header-inner-desktop {
    background: #ffffff;
    color: #490E67;
    border-radius: 0;
  }

  .desktop-search-main .predictive-search-form__header .search-input,.desktop-search-main .predictive-search-form__header .predictive-search__icon {
    color: inherit;
  }
  .desktop-search-main .predictive-search-form__header .search-input::placeholder {
    color: #717171;
  }
  .desktop-search-main .predictive-search-form__header .button{
    background-color: #ee7623;
    letter-spacing: -0.28px;
    text-transform: uppercase;
    border-radius: 0;
    min-height: 50px;
    box-shadow: none !important;
  }

  .header__column--center .search-action {
    width: auto;
    flex-grow: 1;
  }

  :is(.header__column--left, .header__column--center) .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }
{% endstylesheet %}
