{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% liquid
  # Typography variables
  assign font_desktop = block_settings.font_desktop | default: 'default'
  assign font_mobile = block_settings.font_mobile | default: 'default'
  assign font_size_desktop = block_settings.font_size_desktop
  assign font_size_mobile = block_settings.font_size_mobile

  # Underline variables
  assign show_underline = block_settings.show_underline | default: false
  assign underline_thickness = block_settings.underline_thickness | default: 1
  assign underline_offset = block_settings.underline_offset | default: 2
  assign button_size = block_settings.button_size | default: "default"

  # Icon variables
  assign icon = block_settings.icon | default: 'none'
  assign icon_image = block_settings.icon_image
  assign icon_size = block_settings.icon_size | default: 20
  assign icon_position = block_settings.icon_position | default: 'left'
  assign has_icon = false
  if icon != 'none' or icon_image != blank
    assign has_icon = true
  endif

  # Build custom style string
  assign custom_style = ''

  # Add typography styles
  if font_desktop != 'default'
    assign custom_style = custom_style | append: '--font-family-override-desktop: var(--font-' | append: font_desktop | append: '); '
    if font_size_desktop
      assign custom_style = custom_style | append: '--font-size-override-desktop: ' | append: font_size_desktop | append: 'px; '
    endif
  endif

  if font_mobile != 'default'
    assign custom_style = custom_style | append: '--font-family-override-mobile: var(--font-' | append: font_mobile | append: '); '
    if font_size_mobile
      assign custom_style = custom_style | append: '--font-size-override-mobile: ' | append: font_size_mobile | append: 'px; '
    endif
  endif

  # Add underline styles
  if show_underline and block_settings.style_class == 'link'
    assign custom_style = custom_style | append: '--underline-thickness: ' | append: underline_thickness | append: 'px; '
    assign custom_style = custom_style | append: '--underline-offset: ' | append: underline_offset | append: 'px; '
  endif
%}

<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ block_settings.style_class }}
    button--{{ button_size }}
    {{ block_settings.style_class }}--{{ block.id }}
    {% if show_underline and block_settings.style_class == 'link' %}link--underline{% endif %}
    {% if has_icon %}button--has-icon button--icon-{{ icon_position }}{% endif %}
  "
  style="{% render 'size-style', settings: block_settings %}{{ custom_style }}"
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {%- if has_icon and icon_position == 'left' -%}
    {% render 'icon-or-image',
      icon: icon,
      image_upload: icon_image,
      width: icon_size,
      class_name: 'button__icon'
    %}
  {%- endif -%}
  <span class="button__label">{{ block_settings.label }}</span>
  {%- if has_icon and icon_position == 'right' -%}
    {% render 'icon-or-image',
      icon: icon,
      image_upload: icon_image,
      width: icon_size,
      class_name: 'button__icon'
    %}
  {%- endif -%}
</a>

{% stylesheet %}
  /* Button with icon styles */
  .button--has-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .button__icon {
    flex-shrink: 0;
    color: currentColor;
    fill: currentColor;
  }

  .button__icon svg {
    display: block;
    color: inherit;
    fill: currentColor;
  }

  .button__label {
    flex-shrink: 0;
  }

  /* Base link styles */
  .link {
    text-decoration: none;
    text-decoration-color: currentcolor;

    &:hover {
      color: var(--color-primary-hover);
      text-decoration-color: transparent;
    }
  }

  /* Typography overrides */
  a[class*="button"],
  a[class*="link"] {
    @media screen and (min-width: 750px) {
      font-family: var(--font-family-override-desktop, inherit);
      font-size: var(--font-size-override-desktop, inherit);
    }

    @media screen and (max-width: 749px) {
      font-family: var(--font-family-override-mobile, inherit);
      font-size: var(--font-size-override-mobile, inherit);
    }
  }

  /* Custom underline with :after pseudo-element */
  .link--underline {
    position: relative;
    text-decoration: none !important;
    display: inline-block;

    &::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: calc(0 * var(--underline-offset, 2px));
      height: var(--underline-thickness, 1px);
      background-color: currentColor;
      transform-origin: right center;
      transform: scaleX(1);
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    &:hover::after {
      transform-origin: left center;
      transform: scaleX(0);
      opacity: 0.5;
    }

    &:focus-visible::after {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  /* Alternative hover effect - slide from left */
  .link--underline.link--underline-slide {
    &::after {
      transform: scaleX(0);
      transform-origin: left center;
    }

    &:hover::after {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  /* Fade effect */
  .link--underline.link--underline-fade {
    &::after {
      opacity: 1;
    }

    &:hover::after {
      opacity: 0;
    }
  }
  /* Button size variants */
  .button--small,
  .button-secondary--small,
  .button-tertiary--small {
    padding-block: 0.75rem;
  }

  .button--large,
  .button-secondary--large,
  .button-tertiary--large {
    padding-block: 1.5rem;
    padding-inline: 3rem;
  }

  /* Link size variants */
  .link.button--small {
    font-size: 0.875rem;
  }

  .link.button--large {
    font-size: 1.125rem;
  }


{% endstylesheet %}
