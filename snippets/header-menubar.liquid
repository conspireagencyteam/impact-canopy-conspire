{% liquid
  assign block_settings = block.settings
  assign color_scheme_classes = ''
  assign color_scheme_setting_id = 'color_scheme_' | append: section.settings.menu_row
  assign current_color_scheme = block_settings.color_scheme
  assign parent_color_scheme = section.settings[color_scheme_setting_id]

  if parent_color_scheme.id != current_color_scheme.id
    assign color_scheme_classes = ' color-' | append: current_color_scheme
  endif

  # Check if header and menu colors match. This is used to apply different padding styles in css
  if parent_color_scheme.settings.background.rgb == current_color_scheme.settings.background.rgb
    assign color_scheme_classes = color_scheme_classes | append: ' color-scheme-matches-parent'
  endif
%}

<script src="{{ 'dialog.js' | asset_url }}" type="module"></script>

<dialog-component id="menu-modal" class="menu-modal mobile:hidden" ref="headerMenu" {{ block.shopify_attributes }}>
  <button class="button button-unstyled menu-modal__button" aria-label="Open menu" on:click="/showDialog" ref="triggerButton">
    {{ 'icon-menubar.svg' | inline_asset_content }}
    <span class="menu-modal__button-text">Shop All</span>
  </button>

  <dialog ref="dialog" on:click="/closeDialogOnClickOutside" on:keydown="/closeDialogOnEscapePress" class="menu-modal__content dialog-modal color-scheme-1" scroll-lock aria-labelledby="menu-modal-heading">
    {% comment %} <div class="menu-modal__header">
      <button ref="closeButton" on:click="/closeDialog" class="button button-unstyled close-button menu-modal__close-button">
        <span class="svg-wrapper">{{ 'icon-close.svg' | inline_asset_content }}</span>
      </button>
    </div> {% endcomment %}
    <div class="menu-modal__body">
      <ul class="main-menu-item-lists">
        {% for link in block_settings.menu.links %}
        <li class="main-item">
          <a class="main-link" href="{{ link.url }}"{% if link.links %} data-ref="menuitem{{ forloop.index }}"{% endif %}>
            <span class="menu-list__link-title">{{- link.title -}}</span>
            {%- if link.links != blank -%}
              <span class="svg-wrapper icon-caret icon-animated">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            {%- endif -%}
          </a>
        </li>
        {% endfor %}
      </ul>
      <div class="subcontent-menu-items">
        {% for link in block_settings.menu.links %}
          {% assign link_num = forloop.index %}
          {% if link.links!= blank %}  
            <div class="menu-contents menu-contents-{{ link_num }}" id="menuitem{{ link_num }}">
              <div class="item-lists">
                <ul class="sub-items">
                  {% for link in link.links %}
                  {% assign link_obj = link.object %}
                  <li class="sub-item">
                    <a class="link" href="{{ link.url }}">
                      {{ link_obj.featured_image | image_url: width: 100 | image_tag }}
                      <span class="link-title">{{ link.title }}</span>
                    </a>
                  </li>
                  {% endfor %}
                </ul>
              </div>
              {% assign meta_item_title = link.title | handleize %}
              {% assign meta_item = metaobjects.menu_details[meta_item_title] %}
              {% if meta_item != blank %}
                {% assign meta_title = meta_item.accessories_title %}
                {% assign meta_image = meta_item.accessories_image %}
                {% assign meta_point = meta_item.accessories_points %}
                {% assign meta_link = meta_item.accessories_link.value %}
              <div class="menu-detail-meta">
                <div class="image-wrapper">
                  {{ meta_image | image_url: width: 100 | image_tag }}
                </div>
                <div class="detail">
                  <span class="title">{{ meta_title }}</span>
                  <div class="point">
                    {{ meta_point | metafield_tag }}
                  </div>
                </div>
                <div class="link">
                  <a class="button" href="{{ meta_link.url }}">
                    {{ meta_link.text }}
                    {{ 'icon-arrow.svg' | inline_asset_content }} 
                  </a>
                </div>
              </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </dialog>
</dialog-component>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const menuLinks = document.querySelectorAll('.main-link[data-ref]');
    const menuContents = document.querySelectorAll('.menu-contents');

    menuLinks.forEach(link => {
      link.addEventListener('mouseenter', function() {
        // Remove active class from all links and contents
        menuLinks.forEach(l => l.classList.remove('active'));
        menuContents.forEach(c => c.classList.remove('active'));

        // Add active class to current link
        this.classList.add('active');

        // Get the associated content id
        const contentId = this.getAttribute('data-ref');
        const associatedContent = document.getElementById(contentId);

        // Add active class to associated content if it exists
        if (associatedContent) {
          associatedContent.classList.add('active');
        }
      });
    });
  });
</script>

{% stylesheet %}
  .menu-modal__button { 
    display: flex; 
    align-items: center; 
    gap: 8px; 
    font-weight: 500;
    letter-spacing: -0.28px;
    padding: 10px 24px; 
    color: var(--color-foreground);
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.50);
    text-transform: uppercase;
  }
  .menu-modal__button:hover { 
    opacity: 0.7; 
  }
  .menu-modal__content {
    --modal-max-width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    width: var(--modal-max-width);
    max-width: var(--modal-max-width);
    padding: 0;
    border: var(--style-border-popover);
    height: fit-content;
    overflow: hidden;
    min-height: 590px;
    box-shadow: 0 5px 30px rgb(0 0 0 / var(--opacity-15));
    position: fixed;
    margin-top: calc(var(--header-group-height) + 24px) !important;
  }

  @media screen and (max-width: 750px) {
    .menu-modal__content {
      display: block;
      margin: auto 0 0 0;
      min-height: unset; 
      max-width: 100%;
      border-radius: 0;
    }
  }

  .menu-modal__content[open] {
    @media screen and (min-width: 750px) {
      display: flex;
    }
  }
  .menu-modal__header { 
    display: flex; 
    justify-content: space-between; 
    padding: 20px 24px; 
    border-bottom: 1px solid var(--color-border); 
  }
  .menu-modal__title { 
    font-size: 20px; 
    font-weight: bold; 
    margin: 0; 
  }
  .menu-modal__close-button { 
    padding: 8px; 
  }
  .menu-modal__body { 
    overflow-y: auto; 
    padding: 24px;
    width: 100%;
    display: flex;
    gap: 24px;
  } 
  .menu-modal__body .main-menu-item-lists {
    padding: 12px;
    list-style: none;
    gap: 6px;
    border-radius: 8px;
    border: 1px solid #E4E4E4;
    background: #FFF;
    display: flex;
    flex-direction: column;
    margin: 0;
    min-width: 270px;
  }
  .menu-modal__body .main-menu-item-lists .main-link {
    padding: 15px;
    border-radius: 6px;
    gap: 16px; 
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
    display: flex;
    &.active {
      background: #490E67;
      color: #fff;
    }
  }
  .menu-modal__body .main-menu-item-lists .main-link .icon-caret {
    rotate: -90deg;
  }

  .menu-modal__body .subcontent-menu-items {
    flex-grow: 1;
    height: 100%;
    overflow-y: auto;
    position: relative;
  }
  .menu-modal__body .menu-contents {
    display: flex;
    justify-content: space-between;
    height: 100%;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background: #ffffff;
    transition: 0.3s all ease-in-out;
  }
  .menu-modal__body .menu-contents.active {
    opacity: 1;
    visibility: visible;
  }
  .menu-modal__body .menu-contents .sub-items {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    gap: 12px;
  }
  .menu-modal__body .menu-contents .sub-items .sub-item {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
  }
  .menu-modal__body .menu-contents .sub-items .link {
    max-width: 135px;
    border-radius: 6px;
    font-weight: 600;
    transition: all 0.3s ease-in-out;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    img {
      /* mix-blend-mode: multiply; */
    }
    &:hover {
      background: #490E67;
      color: #ffffff;
    }
  }
  .menu-modal__body .menu-contents .menu-detail-meta {
    border-radius: 6px;
    background: #F5F5F5;
    padding: 12px 24px 12px 12px;
    display: flex;
    gap: 24px;
    align-items: center;

  }
  .menu-modal__body .menu-contents .menu-detail-meta .image-wrapper{
    border-radius: 6px;
    max-width: 75px;
    width: 100%;
  }
  .menu-modal__body .menu-contents .detail {
    display: flex;
    gap: 6px;
    flex-direction: column;
  }
  .menu-modal__body .menu-contents .detail .title {
    color: #2A2A2A;
    font-style: normal;
    font-weight: 600;
    letter-spacing: -0.26px;
  }
  .menu-modal__body .menu-contents .detail .point {
    color: #565656;
  }
  .menu-modal__body .menu-contents .link {
    margin-left: auto;
  }
  .menu-modal__body .menu-contents .link .button {
    padding: 8px;
    gap: 4px;
    display: inline-flex;
    align-items: center;
    flex-wrap: nowrap;
    border-radius: 4px;
    border: 1px solid #ccc;
    background: transparent;
    color: #490E67;
    transition: 0.3s all ease-in-out;
  }
  .menu-modal__body .menu-contents .link .button svg{
    width: 20px;
    height: 20px;
  }
  .menu-modal__body .menu-contents .link .button:hover {
    border-color: #490E67;
  }
  @media screen and (max-width: 749px) { 
    .menu-modal { 
      display: none; 
    } 
  }
{% endstylesheet %}
